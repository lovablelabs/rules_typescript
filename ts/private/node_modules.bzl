"""An importer's node_modules, pnpm's top level as declared symlinks.

`node_modules` declares, per npm package the importer declares, the symlink
`node_modules/<name>` into the package's store tree (npm/private/store.bzl);
`node_modules_member` declares one such link for a workspace member. Both
return the links and every store tree they reach as `DefaultInfo.files`, so a
consumer running outside an action -- a generator, a binary, the dev server,
esbuild -- stages the directory and what it links; `ts_compile` and `ts_test`
resolve a direct npm dep along the chain of importers a `node_modules` target
and its `parent`s form (ts/private/rules/ts_compile.bzl).
docs/rules/node-modules.md.
"""

load("//npm/private:store.bzl", "store_link")
load("//tools/launcher:launcher.bzl", "rlocation_path")
load(
    "//ts/private:providers.bzl",
    "NodeModulesInfo",
    "NpmHoistInfo",
    "NpmLinkInfo",
    "NpmPackageInfo",
    "TsInfo",
    "canonical_runtime_file",
    "runtime_mappings",
    "runtime_scope_destinations",
)

def importer_chain(importer):
    chain = [importer]
    for _ in range(1000):
        if chain[-1].parent == None:
            return chain
        chain.append(chain[-1].parent)
    fail("the importer chain from {} is more than 1000 deep".format(
        importer.label,
    ))

def importer_linking(chain, name, member_links):
    for importer in chain:
        link = importer.links.get(name, member_links.get(importer.dir + "/" + name))
        if link != None:
            return struct(name = name, importer = importer, link = link, chain = chain)
    return None

def npm_closure(direct, dep_sets):
    seen = {}
    packages = []

    # Hoists need the closure's package names because pnpm may select a snapshot outside that closure.
    closure = depset(transitive = dep_sets, order = "postorder").to_list()
    for info in direct + closure:
        for reached in [info] + info.transitive_deps.to_list():
            if reached.store.tree not in seen:
                seen[reached.store.tree] = True
                packages.append(reached)
    return packages

def npm_hoist_links(packages, hoist):
    links = []
    for info in packages:
        if info.package_name in hoist.links:
            links.append(hoist.links[info.package_name])
        elif info.package_dir == None and info.package_name in hoist.members:
            links.append(NpmLinkInfo(
                link = hoist.members[info.package_name],
                store = info.store,
            ))
    return links

def _node_modules_dir(ctx):
    parts = [ctx.bin_dir.path, ctx.label.workspace_root, ctx.label.package]
    return "/".join([p for p in parts if p] + ["node_modules"])

def runfiles_dir(ctx, label):
    """The runfiles path of the node_modules directory of the target `label`."""
    repo = label.workspace_name or ctx.workspace_name
    return "/".join([p for p in [repo, label.package] if p] + ["node_modules"])

def _npm_lookup(files, directory, name):
    parts = directory.split("/")
    for depth in range(len(parts), 0, -1):
        if parts[depth - 1] == "node_modules":
            continue
        path = "/".join(parts[:depth] + ["node_modules", name])
        parents = path.split("/")
        for end in range(1, len(parents)):
            parent = "/".join(parents[:end])
            if parent in files:
                return parent, None
        if path in files:
            return path, files[path]
    return None, None

def _npm_source_bindings(ctx, source, declared, names):
    path = rlocation_path(ctx, source)
    directory = path if source.is_directory else path.rsplit("/", 1)[0]
    selected = {}
    for name in names:
        _source_path, original = _npm_lookup(declared, directory, name)
        if original != None:
            selected[name] = original
    return selected

def _npm_context_bindings(ctx, bindings, inputs):
    selected = {}
    for name, (_link, store) in bindings.items():
        selected[name] = rlocation_path(ctx, store)
        inputs[store] = True
    return selected

def _is_executable_source(source):
    return source.extension in ["js", "jsx", "mjs", "cjs", "ts", "tsx", "mts", "cts"] and not source.basename.endswith((".d.ts", ".d.mts", ".d.cts"))

def _npm_lookup_demands(ctx, owners, live_runtime):
    scopes = {}
    stores = {}
    for owner in owners:
        for pairs in [getattr(owner, "runtime_scopes", ()), getattr(owner, "runtime_files", ())]:
            for source, _runtime in pairs:
                if source.basename == "package.json":
                    scopes[source] = True
        for _name, link, store in getattr(owner, "npm_bindings", ()):
            previous = stores.setdefault(link, store)
            if previous != store:
                fail("runtime {}: npm link '{}' has conflicting store identities '{}' and '{}'. Did you mean to publish one store for that link?".format(ctx.label, link.short_path, previous.short_path, store.short_path))
    demands = []
    for owner, pairs in runtime_mappings(owners, live_runtime):
        bindings = getattr(owner, "npm_bindings", ())
        declared = {rlocation_path(ctx, link): link for _name, link, _store in bindings}
        names = {name: True for name, _link, _store in bindings}
        for source, runtime in pairs:
            if not source.is_directory and not _is_executable_source(source):
                continue

            # External package-import targets resolve from the nearest manifest, not the module.
            anchors = [source] + runtime_scope_destinations(scopes, source, rlocation_path(ctx, runtime)).keys()
            lookups = {
                anchor: {name: (link, stores[link]) for name, link in _npm_source_bindings(ctx, anchor, declared, names).items()}
                for anchor in anchors
            }
            demands.append((owner, source, runtime, lookups.pop(source), lookups))
    return demands

def check_dev_server_npm_contexts(ctx, owners, live_runtime, importer, npm_files):
    contexts = {}
    chain = importer_chain(importer) if importer != None else []
    names = {name: True for item in chain for name in item.links}
    member_links = {}
    for owner in owners:
        for name, link, store in getattr(owner, "npm_bindings", ()):
            names[name] = True
            member_links.setdefault(link.path, struct(link = link, store = struct(tree = store)))
    directories = {item.dir: True for item in chain}
    for file in npm_files:
        if not file.is_symlink:
            continue
        directory, name = file.path.rsplit("/", 1)
        if name.startswith((".", "@")):
            continue
        scope = directory.rsplit("/", 1)[-1]
        if scope.startswith("@"):
            directory = directory.rsplit("/", 1)[0]
            name = scope + "/" + name
        if directory in directories:
            names[name] = True
            member_links.setdefault(file.path, struct(link = file, store = None))
    effective = {}
    closures = []
    for name in names:
        selected = importer_linking(chain, name, member_links)
        if selected != None:
            store = selected.link.store
            tree = store.tree if store != None else None
            effective[name] = struct(link = selected.link.link, target = tree or selected.link.link, store = tree)
            if store != None and hasattr(store, "transitive"):
                closures.append(store.transitive)

    app_owner = importer.label if importer != None else "<unset node_modules>"
    for owner, source, _runtime, bindings, scopes in _npm_lookup_demands(ctx, owners, live_runtime):
        for anchor, lookup in [(source, bindings)] + scopes.items():
            for name, (link, expected) in lookup.items():
                actual = effective.get(name)
                if actual != None and actual.store == expected:
                    contexts.setdefault(anchor, {})[name] = True
                    continue
                fail(("ts_dev_server {}: source '{}' from {} declares npm '{}' through {} at store {}, " +
                      "but app importer {} links {}. The dev-server launcher exposes one app importer and cannot " +
                      "preserve this source's npm store. Did you mean to use the same store File for '{}' " +
                      "in both importer chains, or keep these sources in separate dev applications?").format(
                    ctx.label,
                    anchor.short_path,
                    owner.label,
                    name,
                    link.owner,
                    expected.owner,
                    app_owner,
                    actual.store.owner if actual != None and actual.store != None else "an unproven store" if actual != None else "no store for this name",
                    name,
                ))
    return struct(
        contexts = {source: tuple(sorted(names)) for source, names in contexts.items()},
        links = effective,
        files = depset(
            [link.link for link in effective.values()],
            transitive = closures,
            order = "postorder",
        ),
    )

def runtime_npm_contexts(ctx, info, module_paths, available, links = {}):
    contexts = []
    inputs = {}
    owners = info.owners.to_list()
    for _owner, source, runtime, bindings, scopes in _npm_lookup_demands(ctx, owners, module_paths):
        if not _is_executable_source(source):
            continue
        path, selected = module_paths[runtime]
        if selected.is_directory:
            continue
        placed = available.get(path)

        # A different File at the module's path is the runfiles admission's conflict to report.
        if placed == None or canonical_runtime_file(placed, links) != canonical_runtime_file(selected, links):
            continue
        context = {
            "module": path,
            "source": source.short_path,
            "bindings": _npm_context_bindings(ctx, bindings, inputs),
        }
        for scope, destination in runtime_scope_destinations(scopes, source, path).items():
            manifest = available.get(destination)
            if manifest == None:
                continue
            selected = _npm_context_bindings(ctx, scopes[scope], inputs)
            if selected:
                context["package_scope"] = {"manifest": destination, "bindings": selected}
                inputs[manifest] = True
        if not context["bindings"] and "package_scope" not in context:
            continue
        contexts.append(context)
    return contexts, inputs.keys()

def _refuse_foreign_store(ctx, name, store, lockfile = None):
    owner = store.tree.owner
    if owner.workspace_name != ctx.label.workspace_name:
        fail(
            ("{}: '{}' is in the store of @@{}//{}, another repository's " +
             "lockfile. A relative link has one text in the execroot and " +
             "the runfiles tree only inside one repository; declare the " +
             "package in this repository's lockfile.").format(
                ctx.label,
                name,
                owner.workspace_name,
                owner.package,
            ),
        )
    if lockfile != None and owner.package != lockfile.package:
        fail(
            ("{}: '{}' is in the store of //{} and `hoist` names //{}'s; " +
             "an importer's deps and its hoist come from one lockfile.").format(
                ctx.label,
                name,
                owner.package,
                lockfile.package,
            ),
        )

def _hoist(ctx):
    if (ctx.attr.parent == None) == (ctx.attr.hoist == None):
        fail(
            ("{}: an importer names `parent`, the importer above's target, " +
             "or `hoist`, the lockfile's `:node_modules/.pnpm/node_modules`, " +
             "the root importer's; one of the two.").format(ctx.label),
        )
    if ctx.attr.parent != None:
        return ctx.attr.parent[NodeModulesInfo].hoist
    return ctx.attr.hoist[NpmHoistInfo]

def _node_modules_impl(ctx):
    hoist = _hoist(ctx)
    lockfile = ctx.attr.hoist.label if ctx.attr.hoist else None
    links = {}
    linked = {}
    for dep in ctx.attr.deps:
        info = dep[NpmPackageInfo]
        name = info.package_name
        if info.package_dir == None:
            fail(
                ("{}: '{}' is a workspace member; its link is a target of " +
                 "its own:\n" +
                 "node_modules_member(\n" +
                 "    name = \"node_modules/{}\",\n" +
                 "    member = \"{}\",\n" +
                 ")").format(ctx.label, name, name, dep.label),
            )
        if name in linked:
            if linked[name].store.key != info.store.key:
                fail(
                    ("{}: '{}' linked twice, to {} and {}: " +
                     "one link per name").format(
                        ctx.label,
                        name,
                        linked[name].label,
                        dep.label,
                    ),
                )
            continue
        _refuse_foreign_store(ctx, name, info.store, lockfile)
        linked[name] = struct(store = info.store, label = dep.label)
        links[name] = NpmLinkInfo(
            link = store_link(ctx, "node_modules", name, info.store),
            store = info.store,
        )

    packages = npm_closure([dep[NpmPackageInfo] for dep in ctx.attr.deps], [])
    runtime_links = links.values() + npm_hoist_links(packages, hoist)
    files = depset(
        [entry.link for entry in runtime_links],
        transitive = [entry.store.transitive for entry in runtime_links],
        order = "postorder",
    )
    parent = ctx.attr.parent[NodeModulesInfo] if ctx.attr.parent else None
    return [
        DefaultInfo(
            files = files,
            runfiles = ctx.runfiles(transitive_files = files),
        ),
        NodeModulesInfo(
            label = ctx.label,
            dir = _node_modules_dir(ctx),
            links = links,
            parent = parent,
            hoist = hoist,
        ),
    ]

node_modules = rule(
    implementation = _node_modules_impl,
    attrs = {
        "deps": attr.label_list(
            doc = "The npm packages the importer declares, as hub labels " +
                  "(`@npm//web:react`); one link per name, into each " +
                  "package's store tree. A workspace member is a " +
                  "`node_modules_member` target instead.",
            providers = [NpmPackageInfo],
        ),
        "parent": attr.label(
            doc = "The `node_modules` target of the importer above; the " +
                  "lockfile's root importer names `hoist` instead.",
            providers = [NodeModulesInfo],
        ),
        "hoist": attr.label(
            doc = "The lockfile's `npm_store_hoist` target, " +
                  "`:node_modules/.pnpm/node_modules` in the lockfile's " +
                  "package; the root importer names it where every other " +
                  "importer names `parent`.",
            providers = [NpmHoistInfo],
        ),
    },
    doc = """One pnpm importer's `node_modules`: a declared symlink per package
in `deps` at `node_modules/<name>`, into the package's tree in the lockfile's
virtual store, so the target's outputs are the entries of the directory beside
it and one target per package holds them. `DefaultInfo.files` is every link
and every store tree the links reach; `NodeModulesInfo` names the directory,
the links, the parent and the lockfile's hidden hoist, the chain `ts_compile`
and `ts_test` resolve a direct npm dep along. docs/rules/node-modules.md.

    node_modules(
        name = "node_modules",
        deps = ["@npm//:vite"],
        hoist = ":node_modules/.pnpm/node_modules",
    )

    node_modules(
        name = "node_modules",
        deps = [
            "@npm//web:react",
            "@npm//web:vite",
        ],
        parent = "//:node_modules",
    )
""",
)

def _node_modules_member_impl(ctx):
    member = ctx.attr.member
    info = member[NpmPackageInfo]
    name = info.package_name
    if info.package_dir != None:
        fail(
            ("{}: '{}' is a published package, not a workspace member; " +
             "name it in the importer's node_modules `deps`.").format(
                ctx.label,
                name,
            ),
        )
    want = "node_modules/" + name
    if ctx.label.name != want:
        fail(("{}: a member's link target is named after its link, " +
              "'{}'").format(
            ctx.label,
            want,
        ))
    _refuse_foreign_store(ctx, name, info.store)
    link = store_link(ctx, "node_modules", name, info.store)
    files = depset(
        [link],
        transitive = [info.store.transitive, member[TsInfo].npm_files],
        order = "postorder",
    )
    return [
        DefaultInfo(
            files = files,
            runfiles = ctx.runfiles(transitive_files = files),
        ),
        NpmLinkInfo(link = link, store = info.store),
        member[TsInfo],
        info,
    ]

node_modules_member = rule(
    implementation = _node_modules_member_impl,
    attrs = {
        "member": attr.label(
            mandatory = True,
            doc = "The hub's view of the workspace member, `@npm//:<name>`.",
            providers = [NpmPackageInfo, TsInfo],
        ),
    },
    doc = """A workspace member's link into the store, `node_modules/<member
name>` -> the member's tree, one target per `link:` entry of the importer and
named after its link. It forwards the view's `TsInfo` and `NpmPackageInfo`, so
a target under the importer names it in `deps` where it named the view, and
carries the link as `NpmLinkInfo`. A target of its own because a member's
compile walks up to the importers above it: an importer target holding the
link would depend on the member's tree, and through it on that compile.

    node_modules_member(
        name = "node_modules/@lovable/ui",
        member = "@npm//:lovable_ui",
    )
""",
)
