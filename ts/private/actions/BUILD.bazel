    name = "tsconfig",
    srcs = ["tsconfig.bzl"],
    deps = ["//ts/private:toolchain"],
)

bzl_library(
    name = "tsgo",
    srcs = ["tsgo.bzl"],
    deps = [
        "//ts/private:editor_path",
        "//ts/private:providers",
        "//ts/private:toolchain",
    ],
