    # A default: rules_nodejs keeps the root module's tag of this name over this
    # one, so a consumer's .nvmrc wins. runtime.bzl's labels expect the name.
    name = "nodejs",
    node_version = "22.23.1",
)
use_repo(
    node,
    "nodejs_darwin_amd64",
    "nodejs_darwin_arm64",
    "nodejs_linux_amd64",
    "nodejs_linux_arm64",
    "nodejs_windows_amd64",
)

# ─── TypeScript toolchains ──────────────────────────────────────────────────

ts = use_extension("//ts:extensions.bzl", "ts")

# Every fixture ts_compile and ts_test lints under the test hub's oxlint;
# //tests/lint_real is the proof.
ts.lint(
    binary = "@npm//:oxlint_bin",
    config = "//tests/lint_real:oxlint.json",
)
use_repo(
    ts,
    "format_config",
    "lint_config",
    "tsgo_darwin_amd64",
    "tsgo_darwin_arm64",
    "tsgo_linux_amd64",
    "tsgo_linux_arm64",
    "tsgo_source",
)

# Toolchain registration is the CONSUMER's responsibility — consumers add:
#
#   register_toolchains("@rules_typescript//ts/toolchain:all")
#
# to their own MODULE.bazel, matching the rules_go pattern.
#
# dev_dependency is what makes that contract true. Toolchain resolution collects
# register_toolchains() from every module in the graph, not just the root, so a
# non-dev call here would register these toolchains for every consumer whether
# they asked or not. Marked dev, the call applies only when rules_typescript is
# itself the root module, i.e. for this repo's own tests.
register_toolchains(
    "//ts/toolchain:all",
    dev_dependency = True,
)

# ─── npm dependencies ────────────────────────────────────────────────────────

# @npm is the consumer's to claim (the root module's translate_lock wins the
# name); non-dev because //vite's typecheck target names it in this module.
npm = use_extension("//npm:extensions.bzl", "npm")
npm.pnpm(version = "10.32.1")
npm.translate_lock(pnpm_lock = "//tests/npm:pnpm-lock.yaml")

# The esbuild that bundles //vite's plugin. Non-dev because that bundle is
# consumer API, so a dev-only usage would hide it from every consumer.
npm.translate_lock(
    name = "npm_esbuild",
    pnpm_lock = "//vite/esbuild:pnpm-lock.yaml",
)

# The dev hubs: nothing outside this module's tests names them, so no
# consumer's MODULE.bazel.lock records them.
npm_dev = use_extension("//npm:extensions.bzl", "npm", dev_dependency = True)

# Tailwind v4's own hub. //tests/npm's lockfile is a curated fixture -- its
# comments say what each entry is there to prove, and it carries a workspace
# link and a non-root importer that no `pnpm add` regenerates -- so Tailwind's
# thirteen platform-gated oxide packages get their own lock rather than
# re-resolving that one.
npm_dev.translate_lock(
    name = "npm_tailwind",
    pnpm_lock = "//tests/tailwind/lock:pnpm-lock.yaml",
)

# The @typescript-eslint packages, which only //eslint-plugin imports. Their
# own hub for the same reason Tailwind has one, plus a second: eslint pulls a
# large closure that has no business in the tree an app's tests resolve
# against.
npm_dev.translate_lock(
    name = "npm_eslint",
    pnpm_lock = "//tests/eslint:pnpm-lock.yaml",
)

# Cloudflare Workers: the vitest pool that runs tests inside workerd, and the
# wrangler that //tools/codegen:wrangler_types runs; the pool depends on it anyway.
npm_dev.translate_lock(
    name = "npm_workers",
    pnpm_lock = "//tests/workers:pnpm-lock.yaml",
)

# pnpm's patches need a lockfile of their own: tests/npm's is copied verbatim
# into scratch workspaces that pass no patch files.
npm_dev.translate_lock(
    name = "npm_features",
    patches = [
        "//tests/npm/features:patches/@types__ms@2.1.0.patch",
        "//tests/npm/features:patches/nanoid@3.3.11.patch",
        "//tests/npm/features:patches/zod@3.24.2.patch",
    ],
    pnpm_lock = "//tests/npm/features:pnpm-lock.yaml",
)

npm.translate_lock(
    name = "npm_ts_proto",
    pnpm_lock = "//proto/private:pnpm-lock.yaml",
)
use_repo(npm, "npm", "npm_esbuild", "npm_ts_proto", "pnpm")

use_repo(npm_dev, "npm_eslint", "npm_features", "npm_tailwind", "npm_workers")

