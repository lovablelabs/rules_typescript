# Non-dev, so a consumer's build loads //gazelle:BUILD.bazel and gets rules_go,
# the Go SDK and the Go deps without declaring them.
bazel_dep(name = "gazelle", version = "0.47.0")

# Gazelle writes this name into the BUILD files of a repository with no
# MODULE.bazel of its own; the ts extension's Go module repositories are such.
bazel_dep(
    name = "rules_go",
    version = "0.60.0",
    repo_name = "io_bazel_rules_go",
)

# go_repository's root BUILD file loads both for the module's package_info.
