load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//platforms:platforms.bzl", "constraints")
load(
    "//ts/private:toolchain.bzl",
    "LAUNCHER_TOOLCHAIN_TYPE",
    "TSGO_PLATFORMS",
    "launcher_toolchain",
)

go_library(
    name = "launcher",
    srcs = [
        "cleanup.go",
        "config.go",
        "devserver.go",
        "exec_other.go",
        "exec_unix.go",
        "main.go",
        "node.go",
        "nodetest.go",
        "plan.go",
        "reads.go",
        "resolve.go",
        "run.go",
        "vitest.go",
    ],
    importpath = "github.com/mikn/rules_typescript/tools/launcher",
    visibility = ["//visibility:public"],
    deps = [
        "//ts/tools/runtimeview",
        "@io_bazel_rules_go//go/runfiles:go_default_library",
    ],
)

go_binary(
    name = "ts_launcher",
    embed = [":launcher"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "launcher_test",
    srcs = [
        "cleanup_test.go",
        "config_test.go",
        "nodetest_test.go",
        "plan_test.go",
        "reads_test.go",
        "resolve_test.go",
        "symlinked_tmp_test.go",
    ],
    # keep: this package's library is `launcher`, not the `launcher_lib` the Go
    # naming convention picks for a main package.
    embed = [":launcher"],
    deps = [
        "//ts/tools/runtimeview",
        "@io_bazel_rules_go//go/runfiles:go_default_library",
    ],
)

launcher_toolchain(
    name = "source_launcher",
    launcher = ":ts_launcher",
    visibility = ["//visibility:public"],
)

[
    toolchain(
        name = "source_toolchain_" + platform,
        target_compatible_with = constraints(platform),
        toolchain = ":source_launcher",
        toolchain_type = LAUNCHER_TOOLCHAIN_TYPE,
        visibility = ["//visibility:public"],
    )
    for platform in TSGO_PLATFORMS
]
