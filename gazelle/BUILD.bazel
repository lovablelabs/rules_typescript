load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/mikn/rules_typescript/gazelle

# The go_library here is `typescript` and the gazelle() runner is `gazelle`, so
# the Go language would generate a go_test embedding the runner.
# gazelle:exclude *_test.go

go_library(
    name = "typescript",
    srcs = [
        "config.go",
        "emission.go",
        "generate.go",
        "keep.go",
        "labels.go",
        "language.go",
        "manifest.go",
        "npm.go",
        "owner.go",
        "pnpm_lock.go",
        "prefetch.go",
        "prefetch_linux.go",
        "prefetch_other.go",
        "program.go",
        "proto.go",
        "proto_graph.go",
        "resolution_trace.go",
        "resolve.go",
        "tsconfig.go",
        "workers_pool.go",
    ],
    data = [
        "//proto/private:runtime_imports",
        "//ts/toolchain:tsgo_resolved",
    ],
    importpath = "github.com/mikn/rules_typescript/gazelle",
    visibility = ["//visibility:public"],
    x_defs = {
        "tsgoRlocationpath": "$(rlocationpath //ts/toolchain:tsgo_resolved)",
        "protoRuntimeImportsRlocationpath": "$(rlocationpath //proto/private:runtime_imports)",
    },
    deps = [
        "//ts/tools/explainfiles",
        "//ts/tools/jsonc",
        "//ts/tools/tsconfig",
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//language",
        "@gazelle//language/proto",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//walk",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

go_test(
    name = "typescript_test",
    srcs = [
        "converge_cases_test.go",
        "converge_test.go",
        "dev_server_test.go",
        "docs_test.go",
        "emission_test.go",
        "generate_test.go",
        "keep_test.go",
        "kinds_surface_test.go",
        "labels_test.go",
        "manifest_test.go",
        "npm_test.go",
        "owner_test.go",
        "prefetch_test.go",
        "program_test.go",
        "proto_test.go",
        "resolution_trace_test.go",
        "resolve_test.go",
        "tsconfig_extends_test.go",
        "workers_pool_test.go",
    ],
    data = [
        ":gazelle_proto_test",
        "//:docs_pages",
        "//tests/integration:gazelle_roundtrip/configured/vitest.config.mts",
        "//tests/npm:pnpm-lock.yaml",
        "//tests/workers:vitest.workers.config.mjs",
        "//ts/tools/explainfiles:testdata/workers_download_test.listing.txt",
    ],
    embed = [":typescript"],
    env = {"PROTO_GAZELLE": "$(rlocationpath :gazelle_proto_test)"},
    # The fixtures run Gazelle end to end; one shard alone approaches the medium timeout.
    shard_count = 6,
    deps = [
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

gazelle_binary(
    name = "gazelle_typescript",
    languages = [":typescript"],
    visibility = ["//visibility:public"],
)

# Go and proto are here because this repo generates BUILD files for its own .go
# sources; a consumer wants :gazelle_typescript instead.
gazelle_binary(
    name = "gazelle_ts",
    languages = [
        "@gazelle//language/go",
        "@gazelle//language/proto",
        ":typescript",
    ],
    visibility = ["//visibility:public"],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_ts",
)

gazelle_binary(
    name = "gazelle_proto_test",
    testonly = True,
    languages = [
        "@gazelle//language/proto",
        ":typescript",
    ],
)

exports_files(["proto_graph.bzl"])
