load("@rules_typescript//ts:defs.bzl", "ts_compile", "ts_config", "ts_test")

ts_compile(
    name = "lib",
    srcs = ["a.ts"],
    package_scopes = ["//:package.json"],
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
)

ts_test(
    name = "lib_test",
    srcs = ["a.test.ts"],
    tsconfig = ":tsconfig",
    deps = [":lib"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)
