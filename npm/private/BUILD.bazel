# Private implementation files for npm rules.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = [
    "//npm:__subpackages__",
    "//tests:__subpackages__",
    "//ts:__subpackages__",
])

# npm_import.bzl writes a load() of this file into every generated spoke repo's
# BUILD file, so it has to be loadable from an arbitrary external repository.
exports_files(
    ["npm_bin.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "npm_bin",
    srcs = ["npm_bin.bzl"],
    deps = [
        ":store",
        "//ts/private:providers",
        "//ts/private:runtime",
        "//ts/private:runtime_tools",
        "//ts/private:toolchain",
    ],
)

bzl_library(
    name = "npm_import",
    srcs = ["npm_import.bzl"],
    deps = [
        ":fetch_auth",
        ":store",
        ":workspace_package",
        "//ts/private:ts_npm_package",
    ],
)

bzl_library(
    name = "store",
    srcs = ["store.bzl"],
    deps = [
        "//ts/private:providers",
        "//ts/private:toolchain",
    ],
)

bzl_library(
    name = "hoist",
    srcs = ["hoist.bzl"],
    deps = [":npm_translate_lock"],
)

bzl_library(
    name = "fetch_auth",
    srcs = ["fetch_auth.bzl"],
    deps = [":npm_translate_lock"],
)

bzl_library(
    name = "workspace_package",
    srcs = ["workspace_package.bzl"],
    deps = [
        ":store",
        "//ts/private:providers",
    ],
)

bzl_library(
    name = "npm_translate_lock",
    srcs = ["npm_translate_lock.bzl"],
)
