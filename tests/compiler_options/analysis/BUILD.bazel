# keep
node_modules(
    name = "node_modules",
    parent = "//tests/npm:node_modules",
    deps = [
        ":borrowed_culori_types",
        "@npm//:culori",
        "@npm//:vitest",
    ],
)

[
    write_file(
        name = "borrowed_culori_" + kind,
        out = "borrowed_culori/" + filename,
        content = [
            content,
            "",
        ],
    )
    for kind, filename, content in [
        ("manifest", "package.json", '{"name":"@types/culori","version":"0.0.0","types":"index.d.ts"}'),
        ("types_src", "index.d.ts", "export declare function formatHex(colour: string): string;"),
    ]
]

filegroup(
    name = "borrowed_culori_files",
    srcs = [
        ":borrowed_culori_manifest",
        ":borrowed_culori_types_src",
    ],
)

npm_store(
    name = "node_modules/.pnpm/@types+culori@0.0.0/node_modules/@types/culori",
    files = ":borrowed_culori_files",
    package_dir = ":borrowed_culori_manifest",
)

ts_npm_package(
    name = "borrowed_culori_types",
    package_name = "@types/culori",
    package_dir = ":borrowed_culori_manifest",
    package_files = [":borrowed_culori_files"],
    package_version = "0.0.0",
    store = ":node_modules/.pnpm/@types+culori@0.0.0/node_modules/@types/culori",
)

genrule(
    name = "borrowed_scalar_source",
