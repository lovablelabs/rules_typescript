    target_under_test = ":borrowed_importer_inputs",
)

ts_compile(
    name = "native_context_emitted",
    srcs = [":borrowed_scalar_source"],
    emit = True,
    node_modules = ":node_modules",
    tsconfig = ":commonjs_inputs_config",
