        importer = ":node_modules",
        producer = producer,
        source = ":borrowed_scalar_source",
        source_mode = name == "source",
        target_under_test = subject,
        twin = name == "twin",
    )
    for name, producer, subject in [
        ("binary", ":native_context_emitted", ":native_context_binary"),
        ("source", ":borrowed_importer_inputs", ":native_context_source_test"),
        ("twin", ":native_context_emitted", ":native_context_twin_test"),
