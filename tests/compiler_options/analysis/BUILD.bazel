"""Analysis-time coverage: the baseline, the oxc argv, the written tsconfig, and the guards."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude nested
# gazelle:exclude transitioned_types

# The typeRoots directory types_under_type_roots stages: its .d.ts is a src of
# that target, not a package of its own.
# gazelle:exclude type_roots
# gazelle:exclude scope_asset/package.json
# gazelle:exclude scope_asset/asset/package.json
# gazelle:exclude scope_asset/authored/package.json
# gazelle:exclude scope_asset/forwarded/package.json
# gazelle:exclude scope_asset/reused/package.json
# gazelle:exclude scope_asset/transitive/package.json
# gazelle:exclude scope_alias/package.json

# Compiler options, not data: each is named by a tsconfig attr.
# gazelle:exclude tsconfig.commonjs-inputs.json
# gazelle:exclude silent.tsconfig.json
# gazelle:exclude tsconfig.checkjs.json
# gazelle:exclude tsconfig.generated_types.json
# gazelle:exclude tsconfig.nodenext.json
# gazelle:exclude tsconfig.requested_types.json
# gazelle:exclude tsconfig.type_roots.json

# The go_test is hand-named, so the Go language would add a second target for
# the same source.
# gazelle:exclude *_test.go

