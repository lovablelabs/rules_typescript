"""One ts_compile target whose srcs span two sibling directories, none at the root."""

# The targets below have srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude alpha
# gazelle:exclude beta/deep
# gazelle:exclude gamma
# gazelle:exclude delta

load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//tests:flags.bzl", "ts_under_flags")
load("//ts:defs.bzl", "ts_compile")
load(
    ":layout_tests.bzl",
    "data_srcs_test",
    "declared_outputs_test",
    "dep_json_inputs_test",
    "emit_root_test",
    "transitive_data_test",
)

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# alpha/ sorts before beta/, and neither is the package: a strip prefix or a
# rootDir read off one src's directory cannot be right for both trees. alpha/one
# reaches its two siblings -- one in each tree -- through ".js" specifiers,
# which is how TypeScript's own ESM output is written.
ts_compile(
    name = "siblings",
    srcs = [
        "alpha/one.ts",
        "alpha/three.ts",
        "beta/deep/two.ts",
    ],
    emit = True,  # keep
)

# Under --//ts:declaration_map, so the maps land at the same depths.
ts_under_flags(
    name = "siblings_with_declaration_map",
    declaration_map = "true",
    target = ":siblings",
)

# gamma/ is a package tree as Gazelle lists one: the program's one module beside
# its manifest, the JSON it imports, and files nothing compiles.
ts_compile(
    name = "with_data",
    srcs = [
        "gamma/README.md",
        "gamma/data.json",
        "gamma/index.ts",
        "gamma/logo.svg",
        "gamma/styles.css",
    ],
    emit = True,  # keep
    package_scopes = ["gamma/package.json"],
)

ts_compile(
    name = "uses_gamma",
    srcs = ["delta/uses_gamma.ts"],
    emit = True,  # keep
    deps = [":with_data"],
)

filegroup(
    name = "siblings_declarations",
    srcs = [":siblings_with_declaration_map"],
    output_group = "declarations",
)

filegroup(
    name = "with_data_declarations",
    srcs = [":with_data"],
    output_group = "declarations",
)

go_test(
    name = "layout_test",
    size = "small",
    srcs = ["layout_test.go"],
    data = [
        ":siblings_declarations",
        ":siblings_with_declaration_map",
        ":with_data",
        ":with_data_declarations",
    ],
    deps = ["//tests/verify"],
)

declared_outputs_test(
    name = "declared_outputs_test",
    target_under_test = ":siblings",
)

emit_root_test(
    name = "emit_root_test",
    target_under_test = ":siblings",
)

data_srcs_test(
    name = "data_srcs_test",
    target_under_test = ":with_data",
)

transitive_data_test(
    name = "transitive_data_test",
    target_under_test = ":uses_gamma",
)

dep_json_inputs_test(
    name = "dep_json_inputs_test",
    target_under_test = ":uses_gamma",
)
