# gazelle:ignore

load("//tests/compile_layout:layout_tests.bzl", "joined_scope_inputs_test")
load("//ts:defs.bzl", "ts_compile", "ts_config", "ts_test")

ts_config(
    name = "config",
    src = "tsconfig.json",
    module = "nodenext",
)

ts_compile(
    name = "lib",
    srcs = ["lib.ts"],
    emit = True,
    package_scopes = ["package.json"],
    tsconfig = ":config",
)

ts_test(
    name = "joined",
    srcs = ["scope.test.ts"],
    emit = True,
    runner = "//ts/runners:node_test",
    tags = ["manual"],  # Only its program is analyzed below.
    test_srcs = ["scope.test.ts"],
    tsconfig = ":config",
    deps = [":lib"],
)

joined_scope_inputs_test(
    name = "joined_scope_inputs_test",
    target_under_test = ":joined__native_program",
)
