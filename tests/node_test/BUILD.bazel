"""`runner` picks the test runner, and //ts/runners:vitest stays the default.

:collect_test is written against node:test, whose `test()` registers with
nothing vitest collects -- under the default runner the same file collects zero
tests -- so it passes only because `runner` reached the launcher.

:ts_specifier_test pins the other half of running node:test as written: oxc
copies the `./counter.ts` specifier into the .js it emits verbatim, and the
resolver hook the runner installs loads counter.js, the compiled sibling, not
the counter.ts source staged beside it.

:compile_attrs_test pins that the tsconfig reaches a node:test compile as it
reaches a vitest one: a type-only import through its `paths` resolves only if
the alias did, and its `types` entry only if the dep's declaration is staged.
`types` is written, so `node` has to be named there too: a `types` list turns
the @types auto-inclusion off, as under tsc.

:vitest_default_test declares no `runner` and imports vitest, which plain node
cannot resolve out of this layout -- so it fails if the default ever moves.

:runfiles_layout_test pins where the package's code runs: at its runfiles path,
with the test's own source and its `data` entry beside it, as under vitest.

:extensionless_test pins bundler resolution at run time: `./counter` loads
counter.js and `./nested` loads nested/index.js, the compiled files, though
neither specifier names one.

:bare_import_test pins that a bare specifier resolves through the importer's
node_modules into the store, not from whatever `node_modules` the walk up from
`bazel-out` happens to meet.

:module_mocks_test pins that `args` reach node's command line: `mock.module`
exists only under `--experimental-test-module-mocks`.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.compile.json
# gazelle:exclude tsconfig.ts_extensions.json

load("//ts:defs.bzl", "ts_codegen", "ts_compile", "ts_test")

exports_files(
    ["collect.test.ts"],
    visibility = ["//tests/node_test/analysis:__pkg__"],
)

ts_compile(
    name = "counter",
    srcs = ["counter.ts"],
    emit = True,  # keep
    visibility = ["//visibility:public"],
)

ts_test(
    name = "collect_test",
    srcs = ["collect.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    deps = ["@npm//:types_node"],
)

ts_test(
    name = "ts_specifier_test",
    srcs = ["ts_specifier.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    tsconfig = "tsconfig.ts_extensions.json",
    deps = [
        ":counter",
        "@npm//:types_node",
    ],
)

ts_compile(
    name = "staged_ambient",
    srcs = ["staged/ambient.d.ts"],
    emit = True,  # keep
)

ts_test(
    name = "compile_attrs_test",
    srcs = [
        "compile_attrs.test.ts",
        "shared/value.ts",
    ],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    tsconfig = "tsconfig.compile.json",
    deps = [
        ":staged_ambient",
        "@npm//:types_node",
    ],
)

ts_test(
    name = "vitest_default_test",
    srcs = ["vitest_default.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    deps = ["@npm//:vitest"],
)

ts_codegen(
    name = "fixture_tree",
    srcs = ["fixtures/note.txt"],
    args = [
        "stage",
        "-out={out}",
        "{srcs}",
        "note.txt",
    ],
    generator = "//ts/tools/tsaction:tsaction",
    out_dir = "fixtures.json",
)

ts_test(
    name = "runfiles_layout_test",
    srcs = ["runfiles_layout.test.ts"],
    data = [
        "fixtures/note.txt",
        ":fixture_tree",
    ],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    deps = ["@npm//:types_node"],
)

ts_compile(
    name = "nested",
    srcs = ["nested/index.ts"],
    emit = True,  # keep
)

ts_test(
    name = "extensionless_test",
    srcs = ["extensionless.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    deps = [
        ":counter",
        ":nested",
        "@npm//:types_node",
    ],
)

ts_test(
    name = "bare_import_test",
    srcs = ["bare_import.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    deps = [
        "@npm//:types_node",
        "@npm//:zod",
    ],
)

ts_test(
    name = "module_mocks_test",
    srcs = [
        "mocked.ts",
        "module_mocks.test.ts",
    ],
    args = ["--experimental-test-module-mocks"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    tsconfig = "tsconfig.ts_extensions.json",
    deps = ["@npm//:types_node"],
)
