"""A test imports a file of another package by relative path: the file is a
src, exported where it lives, and compiles into this package's output tree
under the program's shared source layout, where the import reaches it."""

load("//ts:defs.bzl", "ts_test")
load(":cross_package_tests.bzl", "cross_package_program_test")

ts_test(
    name = "cross_package_test",
    srcs = [
        "cross_package.test.ts",
        "//tests/vitest/cross_package/lib:engine.ts",  # keep
        "//tests/vitest/cross_package/lib:state.ts",  # keep
    ],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    deps = ["@npm//:vitest"],
)

cross_package_program_test(
    name = "cross_package_program_test",
    target_under_test = ":cross_package_test",
)
