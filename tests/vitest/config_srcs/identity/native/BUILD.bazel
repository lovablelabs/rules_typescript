load("//tests/node_test/analysis:analysis_tests.bzl", "private_module_alias_conflict_test", "private_module_aliases", "private_scope_alias_test")
load("//ts:defs.bzl", "ts_binary", "ts_compile", "ts_test")

# keep
ts_test(
    name = "native_scope_alias_test",
    srcs = ["native_scope.test.mjs"],
    runner = "//ts/runners:node_test",
    deps = ["//tests/vitest/config_srcs/identity/components"],
)

# keep
ts_compile(
    name = "entry",
