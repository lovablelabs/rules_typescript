"""Tests for the tsserver resolution plugin and hook (//tools:tsserver-plugin.js,
//tools:tsserver-hook.js), and for the tsconfig an editor reads.

  :test_worker_map              the worker against a fixture workspace: internal
                                ts_compile packages, including what must stay
                                OUT of the map.
  :test_fragment_map            the same worker, over the fragment bytes a real
                                build wrote for a package-private target: the
                                .bazelrc-optional half of the map.
  :editor_paths_test            that the generated tsconfig's `paths` hold
                                first-party packages and nothing an npm dep
                                brings: the checkout's node_modules answers npm.
  :member_paths_test            that the generated tsconfig says nothing about a
                                pnpm workspace member, which the checkout's
                                node_modules links.
  :fragments_reach_private_test  that those bytes exist at all, for a target no
                                rule in this package may name.
  :test_resolve_integration     the monkey-patch itself -- ts.resolveModuleName
                                answers a first-party package out of the map and
                                falls through for everything else.
  :test_tsserver_diagnostics    a TypeScript language service with the hook
                                active type-checks an import of a first-party
                                package against the .d.ts the map names.
  :test_tsserver_plugin         gold test: a real tsserver process, driven over
                                its own protocol, with the plugin refresh_tsconfig
                                installs. The only test here whose subject is
                                what an editor actually runs.

The last three get node from the JS runtime toolchain and typescript from the
lockfile via :node_modules, so they need nothing from the host.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//npm:defs.bzl", "node_modules")
load("//ts:defs.bzl", "ts_compile")
load("//ts/private:tsconfig_aspect.bzl", "ide_tsconfig")
load(":fragment_tests.bzl", "fragment_files", "fragments_reach_private_test")
load(
    ":ide_tsconfig_tests.bzl",
    "editor_paths_test",
    "member_paths_test",
)

package(default_visibility = ["//:__pkg__"])

# typescript is a genuine dependency of the LSP path, not a stand-in: these
# tests run real TypeScript -- its tsserver binary and its resolveModuleName --
# and tsgo has no equivalent surface.
# keep
node_modules(
    name = "node_modules",
    testonly = True,
    hoist = "//tests/npm:node_modules/.pnpm/node_modules",
    deps = ["@npm//:typescript"],
)

sh_test(
    name = "test_worker_map",
    size = "small",
    srcs = ["test_worker_map.sh"],
    data = [
        "worker_map_test.mjs",
        "//tools:tsserver-hook-worker.js",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# An analysis test cannot write fragments; its compiler dependencies retain
# their original fragments, including the private leaf.
fragment_files(
    name = "fixture_fragments",
    testonly = True,
    dep = ":fragments_reach_private_test",
)

sh_test(
    name = "test_fragment_map",
    size = "small",
    srcs = ["test_fragment_map.sh"],
    data = [
        "fragment_map_test.mjs",
        ":fixture_fragments",
        "//tools:tsserver-hook-worker.js",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

fragments_reach_private_test(
    name = "fragments_reach_private_test",
    member = "//tests/lsp/fragment_fixture:root",
    target_under_test = "//tests/lsp/fragment_fixture:root",
)

sh_test(
    name = "test_resolve_integration",
    size = "small",
    srcs = ["test_resolve_integration.sh"],
    data = [
        "resolve_test.mjs",
        ":node_modules",
        "//tools:tsserver-hook.js",
        "//tools:tsserver-hook-resolver.js",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "test_tsserver_diagnostics",
    size = "small",
    srcs = ["test_tsserver_diagnostics.sh"],
    data = [
        "tsserver_diag_test.mjs",
        ":node_modules",
        "//tools:tsserver-hook.js",
        "//tools:tsserver-hook-resolver.js",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The plugin is the only mechanism a standalone tsserver observes, so this is
# the test that fails when editor resolution regresses. It stages the real
# refresh_tsconfig manifest, so a plugin package installed to the wrong path
# fails here too.
sh_test(
    name = "test_tsserver_plugin",
    size = "small",
    srcs = ["test_tsserver_plugin.sh"],
    data = [
        "tsserver_plugin_test.mjs",
        ":node_modules",
        "//:refresh_tsconfig",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# ── What the generated tsconfig says about npm ────────────────────────────────
# An npm dep, an @types/* dep, and a root config naming neither; analysed only.
ts_compile(
    name = "npm_fixture",
    srcs = ["npm_fixture.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    tags = ["manual"],
    deps = [
        "@npm//:types_node",
        "@npm//:zod",
    ],
)

ide_tsconfig(
    name = "npm_fixture_ide_tsconfig",
    tags = ["manual"],
    deps = [":npm_fixture"],
)

editor_paths_test(
    name = "editor_paths_test",
    target_under_test = ":npm_fixture_ide_tsconfig",
)

# ── The same question for a pnpm workspace member ─────────────────────────────
# Both resolvers read the manifest; the editor map has no //packages/pulse key.
ide_tsconfig(
    name = "member_ide_tsconfig",
    tags = ["manual"],
    deps = ["@npm//:pulse"],
)

member_paths_test(
    name = "member_paths_test",
    target_under_test = ":member_ide_tsconfig",
)
