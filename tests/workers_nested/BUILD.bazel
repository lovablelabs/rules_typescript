load("//npm:defs.bzl", "node_modules")
load("//tests/workers_nested/test:wrangler_config_tests.bzl", "previous_worker_owner")
load("//ts:defs.bzl", "ts_compile", "ts_config")

# The monorepo shape: package.json, the vitest config and the wrangler config at
# the worker root, the tests in test/ as a package of their own.
package(default_visibility = ["//visibility:public"])

# keep
node_modules(
    name = "node_modules",
    hoist = "//tests/workers:node_modules/.pnpm/node_modules",
    deps = ["@npm_workers//:cloudflare_vitest-pool-workers"],
)

# The worker has its srcs in src/; a BUILD file there would turn it into a
# package and make those labels cross a package boundary.
# gazelle:exclude src

# A ts_compile baseline, not data: it is named by the tsconfig attr.
# gazelle:exclude tsconfig.worker.json

# The worker's and its test's options: `webworker` is in no set `target`
# implies, and the two programs are checked against the same lib.
ts_config(
    name = "worker_tsconfig",
    src = "tsconfig.worker.json",
)

exports_files([
    "package.json",
    "src/environment.ts",
    "src/greeting.txt",
    "src/index.ts",
    "src/layout.ts",
    "src/text.d.ts",
    "wrangler.jsonc",
])

# keep
filegroup(
    name = "vitest_config",
    srcs = ["vitest.config.mjs"],
    visibility = ["//visibility:public"],
)

ts_compile(
    name = "worker_assets",
    srcs = [
        "src/greeting.txt",
        "wrangler.jsonc",
    ],
)

ts_compile(
    name = "worker",
    srcs = [
        "src/environment.ts",
        "src/index.ts",
        "src/text.d.ts",
    ],
    emit = True,  # keep
    node_modules = "//tests/workers:node_modules",
    tsconfig = ":worker_tsconfig",
    deps = [
        ":worker_assets",
        "//tests/workers_nested/moved_source:moving_layout",
        "@npm_workers//:zod",
    ],
)

ts_compile(
    name = "source_worker",
    srcs = [
        "src/environment.ts",
        "src/index.ts",
        "src/layout.ts",
        "src/text.d.ts",
    ],
    emit = False,  # keep
    node_modules = "//tests/workers:node_modules",
    tsconfig = ":worker_tsconfig",
    deps = [
        ":worker_assets",
        "@npm_workers//:zod",
    ],
)

# keep
ts_compile(
    name = "previous_worker_compiled",
    srcs = [
        "src/environment.ts",
        "src/index.ts",
        "src/layout.ts",
        "src/text.d.ts",
    ],
    emit = True,
    node_modules = "//tests/workers:node_modules",
    tsconfig = ":worker_tsconfig",
    deps = [
        ":worker_assets",
        "@npm_workers//:zod",
    ],
)

previous_worker_owner(
    name = "previous_worker_provider",
    testonly = True,
    dep = ":previous_worker_compiled",
)

alias(
    name = "previous_worker",
    testonly = True,
    actual = ":previous_worker_provider",
)
