"""Tests for ts_codegen — general-purpose code generation rule.

Tests:
  1. codegen_output_test  — verifies that ts_codegen runs the generator and
                            produces the declared output file with expected content.
  2. codegen_compile_test — verifies that ts_compile can consume ts_codegen output
                            as srcs (end-to-end: generate then compile).
  3. globals_test         — a `.d.ts` out is a dep: the consumer's tsconfig names
                            it in `types` and the entry resolves to the bin-dir file.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tests/compiler_options/analysis:analysis_tests.bzl", "declaration_content_edges_test")
load("//ts:defs.bzl", "ts_codegen", "ts_compile", "ts_config", "ts_test")
load("//ts/private:tsconfig_aspect.bzl", "refresh_workspace_files")
load(":codegen_tests.bzl", "editor_dependency_inputs_test", "editor_owner_provenance_test", "editor_refresh_runfiles_test", "legacy_owner_consumer_test", "legacy_owner_refresh_test", "legacy_ts_info", "outs_codegen_providers_test")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# A compilerOptions baseline, not data: it is named by the tsconfig attr.
# gazelle:exclude tsconfig.globals.json
# gazelle:exclude tsconfig.tree.json

# ── Generator binary ──────────────────────────────────────────────────────────
# A simple shell script generator that writes a TypeScript file with an
# exported constant.  Used to test ts_codegen without requiring any npm deps.
sh_binary(
    name = "test_generator",
    srcs = ["generator.sh"],
)

# ── ts_codegen target ─────────────────────────────────────────────────────────
# Runs the generator against input.ts and declares generated.ts as output.
ts_codegen(
    name = "generated_ts",
    srcs = ["input.ts"],
    outs = ["generated.ts"],
    args = [
        "--srcs-dir",
        "{srcs_dir}",
        "--out",
        "{out}",
    ],
    generator = ":test_generator",
)

# ── Output verification test ──────────────────────────────────────────────────
# Checks that the generated file exists and has the expected content.
go_test(
    name = "codegen_output_test",
    size = "small",
    srcs = ["codegen_output_test.go"],
    data = [":generated_ts"],
    deps = ["//tests/verify"],
)

# ── End-to-end compile test ───────────────────────────────────────────────────
# Compiles a TypeScript file that imports from the generated output.
# This verifies that ts_compile can accept ts_codegen outputs as srcs.
ts_compile(
    name = "generated_compile",
    srcs = [":generated_ts"],
    emit = True,  # keep
)

ts_compile(
    name = "consumer_compile",
    srcs = ["consumer.ts"],
    emit = True,  # keep
    deps = [":generated_compile"],
)

# ── A declaration out, consumed as a dep ──────────────────────────────────────
# The `wrangler types` shape: `types` names it and the codegen dep stages it.
sh_binary(
    name = "globals_generator",
    srcs = ["generate_globals.sh"],
)

ts_codegen(
    name = "generated_globals",
    srcs = ["input.ts"],
    outs = ["generated-globals.d.ts"],
    args = [
        "--out",
        "{out}",
    ],
    generator = ":globals_generator",
)

outs_codegen_providers_test(
    name = "outs_codegen_providers_test",
    target_under_test = ":generated_globals",
)

ts_compile(
    name = "uses_globals",
    srcs = ["uses_globals.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.globals.json",
    deps = [":generated_globals"],
)

build_test(
    name = "globals_test",
    targets = [":uses_globals"],
)

# keep
ts_compile(
    name = "source_globals",
    srcs = ["uses_globals.ts"],
    emit = False,
    tsconfig = "tsconfig.globals.json",
    deps = [":generated_globals"],
)

# keep
ts_compile(
    name = "generated_source",
    srcs = [":generated_ts"],
    emit = False,
)

# keep
ts_test(
    name = "generated_source_runs_without_emit_test",
    srcs = ["generated_source.test.ts"],
    emit = False,
    node_modules = "//tests/npm:node_modules",
    deps = [
        ":generated_source",
        "@npm//:vitest",
    ],
)

ts_codegen(
    name = "globals_tree",
    srcs = ["input.ts"],
    args = [
        "--out",
        "{out}/index.d.ts",
    ],
    generator = ":globals_generator",
    out_dir = "ambient_tree",
)

ts_compile(
    name = "uses_tree_globals",
    srcs = ["uses_tree_globals.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.tree.json",
    deps = [":globals_tree"],
)

declaration_content_edges_test(
    name = "ambient_tree_retains_content_edge_test",
    declaration = "/ambient_tree",
    target_under_test = ":uses_tree_globals",
    tree = True,
)

build_test(
    name = "tree_globals_build_test",
    targets = [":uses_tree_globals"],
)

# keep
ts_compile(
    name = "authored_editor_inputs",
    srcs = [
        "input.ts",
        "tsconfig.tree.json",
    ],
    emit = True,
)

editor_owner_provenance_test(
    name = "authored_editor_inputs_test",
    authored = [
        "input.ts",
        "tsconfig.tree.json",
    ],
    generated = ["input.d.ts"],
    target_under_test = ":authored_editor_inputs",
)

editor_owner_provenance_test(
    name = "scalar_editor_inputs_test",
    generated = ["generated-globals.d.ts"],
    target_under_test = ":generated_globals",
)

editor_owner_provenance_test(
    name = "tree_editor_inputs_test",
    generated = ["ambient_tree"],
    target_under_test = ":globals_tree",
)

editor_owner_provenance_test(
    name = "emitted_editor_inputs_test",
    generated = [
        "generated.d.ts",
        "generated.ts",
    ],
    target_under_test = ":generated_compile",
)

write_file(
    name = "editor_config_base",
    out = "editor-config-base.json",
    content = ["{}"],
)

write_file(
    name = "editor_config_leaf",
    out = "editor-config-leaf.json",
    content = ['{"extends":"./editor-config-base.json","files":["./generated-globals.d.ts"]}'],
)

# keep
ts_config(
    name = "editor_config",
    src = ":editor_config_leaf",
    deps = [":editor_config_base"],
)

# keep
ts_compile(
    name = "editor_dependency_consumer",
    testonly = True,
    srcs = ["uses_globals.ts"],
    emit = False,
    node_modules = "//tests/npm:node_modules",
    tsconfig = ":editor_config",
    deps = [
        ":authored_editor_inputs",
        ":generated_compile",
        ":generated_globals",
        "@npm//:zod",
    ],
)

editor_dependency_inputs_test(
    name = "editor_dependency_inputs_test",
    authored = [
        "input.ts",
        "tsconfig.tree.json",
    ],
    configs = [
        ":editor_config_base",
        ":editor_config_leaf",
    ],
    emitted = ":generated_compile",
    generated_source = ":generated_ts",
    target_under_test = ":editor_dependency_consumer",
)

refresh_workspace_files(
    name = "editor_inputs_refresh",
    testonly = True,
    editor_projects = [":editor_dependency_consumer"],
)

editor_refresh_runfiles_test(
    name = "editor_refresh_runfiles_test",
    configs = [
        ":editor_config_base",
        ":editor_config_leaf",
    ],
    program = ":editor_dependency_consumer",
    target_under_test = ":editor_inputs_refresh",
)

legacy_ts_info(
    name = "legacy_owner",
    dep = ":authored_editor_inputs",
)

# keep
ts_compile(
    name = "legacy_owner_compile",
    srcs = ["input.ts"],
    emit = False,
    deps = [":legacy_owner"],
)

# keep
ts_test(
    name = "legacy_owner_runtime_test",
    srcs = ["generated_source.test.ts"],
    emit = False,
    node_modules = "//tests/npm:node_modules",
    deps = [
        ":generated_source",
        ":legacy_owner",
        "@npm//:vitest",
    ],
)

legacy_owner_consumer_test(
    name = "legacy_owner_compile_analysis_test",
    dep = ":legacy_owner",
    target_under_test = ":legacy_owner_compile",
)

legacy_owner_consumer_test(
    name = "legacy_owner_test_analysis_test",
    dep = ":legacy_owner",
    target_under_test = ":legacy_owner_runtime_test__native_program",
)

# These refresh fixtures intentionally fail analysis; their asserting tests run normally.
refresh_workspace_files(
    name = "legacy_owner_compile_refresh",
    testonly = True,
    editor_projects = [":legacy_owner_compile"],
    tags = ["manual"],
)

refresh_workspace_files(
    name = "legacy_owner_test_refresh",
    testonly = True,
    editor_projects = [":legacy_owner_runtime_test"],
    tags = ["manual"],
)

legacy_owner_refresh_test(
    name = "legacy_owner_compile_refresh_test",
    target_under_test = ":legacy_owner_compile_refresh",
)

legacy_owner_refresh_test(
    name = "legacy_owner_test_refresh_test",
    target_under_test = ":legacy_owner_test_refresh",
)
