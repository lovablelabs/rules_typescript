"""Integration test: the tsgo toolchain comes from this workspace's lockfile.

{RULES_TS_ROOT} is substituted at test runtime with the absolute path to the
rules_typescript checkout. pnpm-lock.yaml is the checked-in one for the first
cases and is rewritten by the runner for the rest.
"""

module(
    name = "test_tsgo_lockfile",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains(
    "@rules_typescript//ts/tools/tsaction:source_toolchain",
    "@rules_typescript//tools/launcher:all",
    "@rules_typescript//ts/toolchain:all",
)

ts = use_extension("@rules_typescript//ts:extensions.bzl", "ts")
ts.tsgo(pnpm_lock = "//:pnpm-lock.yaml")
