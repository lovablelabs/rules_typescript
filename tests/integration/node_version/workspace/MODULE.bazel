"""Integration test: the tests run under the Node this workspace's .nvmrc names.

{RULES_TS_ROOT} is substituted at test runtime with the absolute path to the
rules_typescript checkout. The runner rewrites .nvmrc and removes the
node.toolchain() call for its later cases.
"""

module(
    name = "test_node_version",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains(
    "@rules_typescript//ts/tools/tsaction:source_toolchain",
    "@rules_typescript//tools/launcher:all",
    "@rules_typescript//ts/toolchain:all",
)

bazel_dep(name = "rules_nodejs", version = "6.7.7")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    name = "nodejs",
    node_version_from_nvmrc = "//:.nvmrc",
)

npm = use_extension("@rules_typescript//npm:extensions.bzl", "npm")
npm.translate_lock(pnpm_lock = "//:pnpm-lock.yaml")
use_repo(npm, "npm")
