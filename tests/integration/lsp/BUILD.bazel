"""Root BUILD file for the lsp integration test workspace."""

load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_virtual_store")
load("@rules_typescript//ts:defs.bzl", "ts_add_package", "ts_pnpm", "ts_refresh_tsconfig")

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)

npm_virtual_store(name = "node_modules/.pnpm")

ts_pnpm(name = "pnpm")

ts_add_package(
    name = "add_package",
    pnpm_lock = "//:pnpm-lock.yaml",
)

# //src checks under its own tsconfig.json, which is its editor program too, so
# nothing is nested. `deps` is what the aspect walks.
ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    deps = [
        "//authored/nested",
        "//src",
    ],
)
