"""Integration test: LSP / IDE tsconfig generation.

Verifies that `bazel run //:refresh_tsconfig` generates a root tsconfig.json
that names no npm package in paths (e.g. "zod": the checkout's node_modules
answers those), leaves src/tsconfig.json -- the package's program and the
editor's -- as written, and keeps its files out of the root program.

The {RULES_TS_ROOT} placeholder is substituted at test runtime by test_runner.sh
with the absolute path to the rules_typescript checkout.
"""

module(
    name = "test_lsp",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
bazel_dep(name = "gazelle", version = "0.54.0")

local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains(
    "@rules_typescript//ts/tools/tsaction:source_toolchain",
    "@rules_typescript//tools/launcher:all",
    "@rules_typescript//ts/toolchain:all",
)

npm = use_extension("@rules_typescript//npm:extensions.bzl", "npm")
npm.translate_lock(pnpm_lock = "//:pnpm-lock.yaml")
use_repo(npm, "npm", "pnpm")
