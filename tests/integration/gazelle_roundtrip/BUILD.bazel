"""Root BUILD file for the gazelle_roundtrip integration test workspace."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_virtual_store")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_typescript//ts:defs.bzl", "ts_pnpm")

exports_files(
    ["package.json"],
    visibility = ["//visibility:public"],
)

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)

npm_virtual_store(name = "node_modules/.pnpm")

# The runner installs node_modules with it before the first Gazelle pass: the
# listing must run over the tree the build will check.
ts_pnpm(name = "pnpm")

# Hand-written: Gazelle deleting a test target satisfies both "the output
# builds" and "two runs are byte-identical", so the runner compares the set.
build_test(
    name = "app_builds_test",
    targets = ["//src/app"],
)

# The generator src/i18n's hand-written ts_codegen names.
sh_binary(
    name = "catalogue_gen",
    srcs = ["tools/catalogue_gen.sh"],
    visibility = ["//visibility:public"],
)

# The generator the runner's src/locales ts_codegen names; the compiled/ tree
# checked in beside it stands in for what a local run leaves behind.
sh_binary(
    name = "tree_gen",
    srcs = ["tools/tree_gen.sh"],
    visibility = ["//visibility:public"],
)

# The generator the runner's worker/ ts_codegen names.
sh_binary(
    name = "env_types_gen",
    srcs = ["tools/env_types_gen.sh"],
    visibility = ["//visibility:public"],
)
