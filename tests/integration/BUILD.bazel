# ── gazelle_roundtrip ─────────────────────────────────────────────────────────
# Two Gazelle passes diffed, then build and test, over an installed workspace.
# The runner's GAZELLE_ROUNDTRIP_GROUP splits checks over pass 1 across targets.

# The nested workspace's //:gazelle, run by the action below as `bazel run` runs it there.
gazelle(
    name = "gazelle_roundtrip_gazelle",
    testonly = True,
    gazelle = "//gazelle:gazelle_typescript",
    tags = ["manual"],
)

tsgo_source_tool(
    name = "gazelle_roundtrip_gazelle_tool",
    testonly = True,
    actual = ":gazelle_roundtrip_gazelle",
    tags = ["manual"],
)

# Staged, installed and through Gazelle's first pass once; every group starts from it.
gazelle_roundtrip_workspace(
    name = "gazelle_roundtrip_workspace",
    testonly = True,
    srcs = integration_test_utils.glob_workspace_files("gazelle_roundtrip"),
    fixture = package_name() + "/gazelle_roundtrip",
    gazelle = ":gazelle_roundtrip_gazelle_tool",
    generator = "//tests/integration/runners:gazelle_roundtrip_runner",
    pnpm = "@pnpm//:pnpm_bin",
    registry = "@gazelle_roundtrip_tarballs//:registry",
    tags = ["manual"],
    workers_lock = "//tests/workers:pnpm-lock.yaml",
)

bazel_integration_test(
    name = "gazelle_roundtrip_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = [
        ":gazelle_roundtrip_workspace",
        "//:MODULE.bazel",
        "@gazelle_roundtrip_tarballs//:registry",
    ],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:gazelle_roundtrip_runner",
    workspace_files = integration_test_utils.glob_workspace_files("gazelle_roundtrip"),
    workspace_path = "gazelle_roundtrip",
