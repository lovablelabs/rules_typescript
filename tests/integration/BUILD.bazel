# ── gazelle_roundtrip ─────────────────────────────────────────────────────────
# Two Gazelle passes diffed, then build and test, over an installed workspace.
# The runner's GAZELLE_ROUNDTRIP_GROUP splits checks over pass 1 across targets.

_FORMAL_TAGS = nested_bazel_tags(cpus = 4) + ["ci-merge-gate"]

conformance_inputs(
    name = "formal_tools",
    testonly = True,
    canonical = "//ts/tools/runtimeview/conformance:conformance",
    java = "@rules_java//toolchains:remotejdk_21",
    models = "//formal/runfiles_identity:sources",
    producer = "//ts/private/rules/conformance:export_producer_traces",
    reservation_tags = _FORMAL_TAGS,
    tlc = "@tlc//file",
)

bazel_integration_test(
    name = "gazelle_roundtrip_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags() + ["ci-merge-gate"],
    test_runner = "//tests/integration/runners:gazelle_roundtrip_runner",
    workspace_files = integration_test_utils.glob_workspace_files("gazelle_roundtrip"),
    workspace_path = "gazelle_roundtrip",
)

