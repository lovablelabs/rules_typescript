"""Bazel integration tests for rules_typescript.

These tests use rules_bazel_integration_test to run child Bazel workspaces
that simulate real user scenarios end-to-end:
  - create a project from scratch
  - run Gazelle to generate BUILD files
  - build with ts_compile / tsgo type-checking
  - run ts_test / vitest (the tests carrying a pnpm-lock.yaml)

Each test workspace lives in a subdirectory of this package and contains:
  - MODULE.bazel (with {RULES_TS_ROOT} placeholder substituted at runtime)
  - BUILD.bazel, .bazelrc, .bazelversion
  - TypeScript source files

The runner is a `go_binary` in //tests/integration/runners, one per test, over
the shared //tests/integration/harness: scratch layout, workspace staging,
RULES_TS_ROOT resolution, inner-Bazel invocation and cleanup live there, and
each runner keeps only its own assertions.

The harness resolves the rules_typescript source root at runtime -- from the
runfiles MODULE.bazel, falling back to walking up from BIT_WORKSPACE_DIR -- so
the ruleset's own .bzl files are NOT action inputs: editing a rule does not
invalidate these tests. They carry `external` so Bazel runs them
unconditionally rather than serving a stale PASS; use `--config=fast` (which
filters `-nested-bazel`) for the everyday loop.

None of these is `exclusive` or `manual`: a plain `bazel test //...` runs them,
which is the only reason the negative cases below are ever checked. CPU
reservations bound how many nested Bazel servers share one machine. Which CI
leg runs a test is its shard tag; tags.bzl holds both.

  bazel test //tests/integration/...                 the whole suite
  bazel test //tests/integration:integration_tests   the tests in this package
  bazel test //tests/integration:new_project_test    one of them
  bazel test --config=ci-integration-npm \
    //tests/integration/...                          one CI leg's subset
  bazel test --config=fast //...                     everything BUT these

The nested-Bazel tests outside this package --
//tests/integration/consumer_crates, //tests/integration/node_version,
//tests/integration/npm_integrity, //tests/integration/npm_registries,
//tests/integration/store_cache and //tests/integration/tsgo_lockfile -- are
not in :integration_tests and cannot be: no such package exports its test.
`//tests/integration/...`, which is what CI runs, is the pattern that covers
these tests and //tests/integration/harness:harness_test, the harness's own go_test.
"""

# Each child workspace is staged into a scratch dir at test time; Gazelle must
# not generate BUILD files inside them. `harness/` and `runners/` are absent
# from this list on purpose -- they are first-party Go it should keep managing.
# gazelle:exclude codegen
# gazelle:exclude consumer_crates
# gazelle:exclude dev_server
# gazelle:exclude existing_project
# gazelle:exclude proto_generated
# gazelle:exclude gazelle_roundtrip
# gazelle:exclude lsp
# gazelle:exclude new_project
# gazelle:exclude node_version
# gazelle:exclude npm_deps
# gazelle:exclude npm_registries
# gazelle:exclude oxc_declarations
# gazelle:exclude tsgo_lockfile

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("//tests/integration:tags.bzl", "nested_bazel_tags")
load("//ts/private/rules/conformance:inputs.bzl", "conformance_inputs")

# The combined vitest-config listing in //gazelle:typescript_test runs over it.
exports_files(
    ["gazelle_roundtrip/configured/vitest.config.mts"],
    visibility = ["//gazelle:__pkg__"],
)

# ── new_project ───────────────────────────────────────────────────────────────
# Full new-project journey: write sources → gazelle → build.
# TypeScript files have explicit return types (isolatedDeclarations = true).
# No npm deps.

bazel_integration_test(
    name = "new_project_test",
    timeout = "eternal",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    # MODULE.bazel is added to data so it appears in the runfiles tree as
    # _main/MODULE.bazel — a symlink the harness resolves to the real checkout.
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:new_project_runner",
    workspace_files = integration_test_utils.glob_workspace_files("new_project"),
    workspace_path = "new_project",
)

# ── npm_deps ──────────────────────────────────────────────────────────────────
# zod type-checked and vitest run over the workspace's own installed lockfile.

bazel_integration_test(
