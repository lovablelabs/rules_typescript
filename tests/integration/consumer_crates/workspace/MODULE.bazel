module(
    name = "test_consumer_crates",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains(
    "@rules_typescript//ts/tools/tsaction:source_toolchain",
    "@rules_typescript//tools/launcher:all",
    "@rules_typescript//ts/toolchain:all",
)

bazel_dep(name = "rules_rs", version = "0.2.1")
bazel_dep(name = "llvm", version = "0.8.26")

rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    name = "consumer_rust_toolchains",
    edition = "2024",
    version = "1.91.0",
)
use_repo(rust, "consumer_rust_toolchains", "default_rust_toolchains")

register_toolchains("@consumer_rust_toolchains//...", "@llvm//toolchain:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
    ],
)
use_repo(crate, "crates")
