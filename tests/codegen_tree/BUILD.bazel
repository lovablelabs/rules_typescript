"""A ts_codegen out_dir consumed by a ts_compile.

The generator writes one .js/.d.ts pair per name in names.txt, so the file set
exists only once it has run and the output has to be a directory. That
directory is a dep, never a src: srcs declares one output per file at analysis
time and a directory has no file list to declare from.
"""

load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//ts:defs.bzl", "ts_codegen", "ts_compile", "ts_dev_server")
load(":tree_tests.bzl", "dev_server_declared_tree_test", "tree_reaches_compile_test")

package(default_visibility = ["//:__pkg__"])

# The go_test is hand-named: `codegen_tree_test` is the name the Go language
# generates for this directory, and it would delete the rule as empty once the
# exclude below hides its source. names.txt is the generator's input, not an
# asset target.
# gazelle:exclude *_test.go
# gazelle:exclude names.txt

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.tree.json

sh_binary(
    name = "tree_generator",
    srcs = ["gen_tree.sh"],
)

ts_codegen(
    name = "tree",
    srcs = ["names.txt"],
    args = [
        "--names",
        "{srcs}",
        "--outdir",
        "{out}",
    ],
    generator = ":tree_generator",
    out_dir = "compiled",
    visibility = [
        "//:__pkg__",
        "//tests/dev_server:__pkg__",
        "//tests/workers_nested/test:__pkg__",
    ],
)

# The tsconfig's `paths` sends `#codegen/tree` to ./compiled; the value's bin-dir
# twin is where the tree is.
ts_compile(
    name = "consumer",
    srcs = ["consumer.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.tree.json",
    deps = [":tree"],
)

# The same tree by relative path. tsgo resolves it through rootDirs; the
# undeclared-import check resolves it through the directory the manifest names,
# since it has no file list to match against.
ts_compile(
    name = "relative_consumer",
    srcs = ["relative_consumer.ts"],
    emit = True,  # keep
    deps = [":tree"],
)

filegroup(
    name = "consumer_declarations",
    srcs = [":consumer"],
    output_group = "declarations",
)

go_test(
    name = "tree_output_test",
    size = "small",
    srcs = ["codegen_tree_test.go"],
    data = [
        ":consumer",
        ":consumer_declarations",
        ":js_consumer_declarations",
        ":js_downstream",
        ":tree",
    ],
    deps = ["//tests/verify"],
)

tree_reaches_compile_test(
    name = "tree_reaches_compile_test",
    size = "small",
    target_under_test = ":consumer",
    tree = ":tree",
)

# One target further out, importing the tree by the same alias.
ts_compile(
    name = "downstream",
    srcs = ["downstream.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.tree.json",
    deps = [
        ":consumer",
        ":tree",
    ],
)

# The paraglide shape: a JavaScript src (allowJs) beside a tree whose `.js`
# and `.d.ts` sit under the tsconfig's pattern.
ts_compile(
    name = "js_consumer",
    srcs = [
        "helper.js",
        "js_consumer.ts",
    ],
    emit = True,  # keep
    tsconfig = "tsconfig.tree.json",
    deps = [":tree"],
)

# Reads js_consumer's declarations, so its build runs TsgoDeclare js_consumer.
ts_compile(
    name = "js_downstream",
    srcs = ["js_downstream.ts"],
    emit = True,  # keep
    deps = [":js_consumer"],
)

filegroup(
    name = "js_consumer_declarations",
    srcs = [":js_consumer"],
    output_group = "declarations",
)

# keep
ts_compile(
    name = "source_consumer",
    srcs = ["consumer.ts"],
    emit = False,
    tsconfig = "tsconfig.tree.json",
    deps = [":tree"],
)

ts_dev_server(
    name = "dev",
    entry_point = ":source_consumer",
    node_modules = "//tests/npm:node_modules",
    plugin = "//vite:vite_plugin_bazel",
    server = "//vite:dev_server",
)

dev_server_declared_tree_test(
    name = "dev_server_retains_declared_tree_test",
    entry = ":source_consumer",
    target_under_test = ":dev",
    tree = ":tree",
)
