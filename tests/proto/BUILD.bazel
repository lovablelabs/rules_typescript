load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//npm:defs.bzl", "node_modules")
load("//proto:defs.bzl", "ts_proto_library")
load("//ts:defs.bzl", "ts_test")

# gazelle:ignore

proto_library(
    name = "common_proto",
    srcs = ["common.proto"],
    import_prefix = "proof/v1",
    strip_import_prefix = "/tests/proto",
)

proto_library(
    name = "message_proto",
    srcs = ["message.proto"],
    import_prefix = "proof/v1",
    strip_import_prefix = "/tests/proto",
    deps = [":common_proto"],
)

proto_library(
    name = "service_proto",
    srcs = ["service.proto"],
    import_prefix = "proof/v1",
    strip_import_prefix = "/tests/proto",
    deps = ["@protobuf//:descriptor_proto"],
)

node_modules(
    name = "node_modules",
    parent = "//tests/npm:node_modules",
    deps = [
        "@npm//:vitest",
        "@npm_ts_proto//:bufbuild_protobuf",
    ],
)

ts_proto_library(
    name = "common",
    node_modules = ":node_modules",
    options = [
        "target=ts",
        "json_types=true",
        "import_extension=none",
    ],
    out_dir = "generated",
    proto = ":common_proto",
    tsconfig = "tsconfig.json",
    deps = ["@npm_ts_proto//:bufbuild_protobuf"],
)

ts_proto_library(
    name = "message",
    node_modules = ":node_modules",
    options = [
        "target=ts",
        "json_types=true",
        "import_extension=none",
    ],
    out_dir = "generated",
    proto = ":message_proto",
    tsconfig = "tsconfig.json",
    deps = [
        ":common",
        "@npm_ts_proto//:bufbuild_protobuf",
    ],
)

ts_test(
    name = "generated_source_json_test",
    srcs = ["generated.test.ts"],
    node_modules = ":node_modules",
    tsconfig = "tsconfig.json",
    deps = [
        ":message",
        "@npm//:vitest",
        "@npm_ts_proto//:bufbuild_protobuf",
    ],
)

ts_proto_library(
    name = "service",
    node_modules = ":node_modules",
    out_dir = "generated",
    proto = ":service_proto",
    tsconfig = "tsconfig.json",
    deps = ["@npm_ts_proto//:bufbuild_protobuf"],
)

# The golden is buf v1.73.0's `buf generate` of proof/v1/service.proto with
# protoc-gen-es 2.16.0, `opt: target=ts` and `types: [proof.v1]`.
diff_test(
    name = "service_buf_descriptor_test",
    file1 = ":service_generate",
    file2 = "service_pb.ts.golden",
)
