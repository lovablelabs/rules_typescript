"""An import must be satisfied by a DIRECT dep.

The chain here is hidden.ts <- leaf.ts <- middle.ts, one ts_compile target per
file, so a relative specifier crosses a target boundary the way a bare one
crosses a package boundary. Every target below declares what it imports, so the
whole package builds; the analysis tests pin what the tsgo action reads and what
its ownership manifest says, and //tests/integration:new_project_test fails a
real build over the same chain.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")
load(":strict_deps_tests.bzl", "resolution_surface_test", "tsgo_check_test")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "hidden",
    srcs = ["hidden.ts"],
    emit = True,  # keep
)

ts_compile(
    name = "leaf",
    srcs = ["leaf.ts"],
    emit = True,  # keep
    deps = [":hidden"],
)

ts_compile(
    name = "middle",
    srcs = ["middle.ts"],
    emit = True,  # keep
    deps = [":leaf"],
)

# ./hidden arrives here through :middle and :leaf as well. Declaring it is what
# makes the import legal -- delete that dep and the build must fail naming
# //tests/strict_deps:hidden.
ts_compile(
    name = "declared",
    srcs = ["declared.ts"],
    emit = True,  # keep
    deps = [
        ":hidden",
        ":leaf",
        ":middle",
    ],
)

# ./leaf names a file this target does not own, and only :leaf provides it.
ts_compile(
    name = "relative",
    srcs = ["relative.ts"],
    emit = True,  # keep
    deps = [":leaf"],
)

# Node built-ins, with and without the node: prefix, resolve into the declared
# @types/node.
ts_compile(
    name = "builtins",
    srcs = ["builtins.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    deps = ["@npm//:types_node"],
)

# An import inside the target resolves to its own src.
ts_compile(
    name = "inside",
    srcs = [
        "inside.ts",
        "inside_part.ts",
    ],
    emit = True,  # keep
)

# `acme-bridge` is installed nowhere: the .d.ts beside the source IS the module, so
# no deps is the assertion, for tsgo, the undeclared-import check and Gazelle alike.
ts_compile(
    name = "ambient_module",
    srcs = [
        "ambient_module.d.ts",
        "ambient_module_user.ts",
    ],
    emit = True,  # keep
)

build_test(
    name = "ambient_module_test",
    targets = [":ambient_module"],
)

# Every edge of these resolves to an own src, a direct dep's file or a direct
# npm package: the check passes and the targets build.
build_test(
    name = "declared_deps_test",
    targets = [
        ":builtins",
        ":declared",
        ":inside",
        ":relative",
    ],
)

# middle.ts reaches hidden.d.ts only through :leaf; the manifest says so, and
# the tsgo action reads it beside the edges tsgo lists.
tsgo_check_test(
    name = "tsgo_check_test",
    size = "small",
    lines = [
        "label\t//tests/strict_deps:middle",
        "own\ttests/strict_deps/middle.ts",
        "direct\t//tests/strict_deps:leaf",
    ],
    target_under_test = ":middle",
)

tsgo_check_test(
    name = "tsgo_check_npm_test",
    size = "small",
    npm_direct = ["@npm//:types_node"],
    npm_reachable = {"@npm//:undici-types": "@npm//:undici-types"},
    target_under_test = ":builtins",
)

resolution_surface_test(
    name = "resolution_surface_test",
    size = "small",
    target_under_test = ":middle",
    transitive_dep = ":hidden",
)
