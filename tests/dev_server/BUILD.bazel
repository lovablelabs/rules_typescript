load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_binary", "ts_codegen", "ts_compile", "ts_dev_server")
load("//tests/npm:direct_version_tests.bzl", "direct_npm_identity_test")
load(":configuration_fixture.bzl", "configuration_source", "transitioned_source")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# Compile the minimal app entry point.
ts_compile(
    name = "app",
    srcs = ["app.ts"],
    emit = True,  # keep
)

# The dev servers' entry point, and a //:refresh_tsconfig root.
ts_compile(
    name = "dev_app",
    srcs = ["dev_app.ts"],
    data = [
        "settings.mjs",
        "theme.css",
        ":declared_missing_asset",
        "//tests/dev_server_assets:helper.mjs",
        "//tests/dev_server_assets:nested.css",
        "//tests/dev_server_assets:payload.svg",
        "//tests/dev_server_assets:style.css",
    ],  # keep
    emit = True,  # keep
    deps = [
        ":declared_generated_sources",
        ":generated_package",
        "//tests/codegen_tree:tree",
        "//tests/dev_server/lib",
    ],  # keep
)

ts_binary(
    name = "package_generator",
    entry_point = "generate_package.mjs",
)

ts_codegen(
    name = "generated_package",
    srcs = ["generate_package.mjs"],
    args = ["{out}"],
    generator = ":package_generator",
    out_dir = "generated_package",
)

write_file(
    name = "declared_generated_ts",
    out = "declared_source/value.ts",
    content = [
        'import { packageName } from "../lib/index.js";',
        'export const generated: string = "DECLARED_GENERATED_TS_V1";',
        "export { packageName };",
    ],
)

write_file(
    name = "declared_generated_json",
    out = "declared_source/value.json",
    content = ['{"value":"DECLARED_GENERATED_JSON_V1"}'],
)

[
    write_file(
        name = "declared_generated_" + extension,
        out = "declared_source/extension-" + extension + "." + extension,
        content = ['export const marker = "DECLARED_SCALAR_' + extension.upper() + '";'],
    )
    for extension in [
        "tsx",
        "js",
        "mjs",
    ]
]

write_file(
    name = "declared_missing_source",
    out = "declared_source/missing.tsx",
    content = ['export const marker = "DECLARED_MISSING_SOURCE";'],
)

write_file(
    name = "declared_missing_asset",
    out = "declared_missing.css",
    content = [".declared-missing { color: red; }"],
)

# keep
ts_compile(
    name = "declared_generated_sources",
    srcs = [
        ":declared_generated_js",
        ":declared_generated_json",
        ":declared_generated_mjs",
        ":declared_generated_ts",
        ":declared_generated_tsx",
        ":declared_missing_source",
    ],
    emit = False,
    deps = ["//tests/dev_server/lib:source_lib"],
)

write_file(
    name = "scoped_generated_ts",
    out = "scoped/generated.ts",
    content = [
        'import { helper } from "#helper";',
        'import { generatedHelper } from "#generated-helper";',
        'import { selfHelper } from "@fixture/declared-scope/self-helper";',
        'export const generated: string = "DECLARED_SCOPED_GENERATED";',
        "export { generatedHelper, helper, selfHelper };",
    ],
)

write_file(
    name = "scoped_generated_helper_ts",
    out = "scoped/generated-helper.ts",
    content = ['export const generatedHelper: string = "DECLARED_GENERATED_SCOPE_HELPER";'],
)

write_file(
    name = "scoped_self_helper_ts",
    out = "scoped/self-helper.ts",
    content = ['export const selfHelper: string = "DECLARED_SELF_REFERENCE_HELPER";'],
)

_SHARED_SCALAR_FILES = {
    side: {
        "value.ts": [
            'export { relative } from "./helper.js";',
            'export { scoped } from "#helper";',
        ],
        "helper.ts": ['export const relative: string = "DECLARED_RELATIVE_{}";'.format(side.upper())],
        "scoped-helper.ts": ['export const scoped: string = "DECLARED_SCOPE_{}";'.format(side.upper())],
        "imports.ts": ['export { relative, scoped } from "#value";'],
        "self.ts": ['export {{ relative, scoped }} from "@fixture/shared-scalar-{}/value";'.format(side)],
        "package.json": [json.encode({
            "name": "@fixture/shared-scalar-" + side,
            "type": "module",
            "exports": {"./value": {
                "types": "./value.ts",
                "default": "./value.js",
            }},
            "imports": {
                "#value": {
                    "types": "./value.ts",
                    "default": "./value.js",
                },
                "#helper": {
                    "types": "./scoped-helper.ts",
                    "default": "./scoped-helper.js",
                },
            },
        })],
    }
    for side in [
        "a",
        "b",
    ]
}

[
    write_file(
        name = "shared_scalar_{}_{}".format(
            side,
            filename.replace(".", "_"),
        ),
        out = "shared_scalars/{}/{}".format(side, filename),
        content = content,
    )
    for side, files in _SHARED_SCALAR_FILES.items()
    for filename, content in files.items()
]

# keep
ts_compile(
    name = "source_contexts",
    srcs = [
        "npm_context/value.ts",
        "scoped/helper.mjs",
        ":scoped_generated_helper_ts",
        ":scoped_generated_ts",
        ":scoped_self_helper_ts",
    ] + [
        ":shared_scalar_{}_{}".format(
            side,
            filename.replace(".", "_"),
        )
        for side, files in _SHARED_SCALAR_FILES.items()
        for filename in files
        if filename != "package.json"
    ],
    emit = False,
    node_modules = ":node_modules",
    package_scopes = ["scoped/package.json"] + [":shared_scalar_{}_package_json".format(side) for side in _SHARED_SCALAR_FILES],
    deps = ["@npm//:zod"],
)

# keep
ts_dev_server(
    name = "dev_source_contexts",
    entry_point = ":source_contexts",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5185,
    server = "//vite:dev_server",
)

# keep
ts_dev_server(
    name = "dev_member_npm",
    entry_point = "//tests/dev_server/member",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5186,
    server = "//vite:dev_server",
)

# keep
ts_compile(
    name = "member_pair",
    srcs = [],
    emit = False,
    node_modules = ":node_modules",
    tags = ["manual"],  # Reached only through the rejected dev server.
    deps = [
        "//tests/dev_server/member",
        "//tests/dev_server/member/other",
    ],
)

# keep
ts_dev_server(
    name = "dev_member_pair",
    entry_point = ":member_pair",
    node_modules = ":node_modules",
    tags = ["manual"],  # Rejected subject is reached by the analysis test.
)

direct_npm_identity_test(
    name = "member_importers_cannot_split_one_npm_name_across_stores_test",
    messages = [
        "npm 'member-only' is linked only by member importers",
        "member-only@1.0.0/node_modules/member-only",
        "member-only@2.0.0/node_modules/member-only",
    ],
    target_under_test = ":dev_member_pair",
)

# keep
ts_dev_server(
    name = "dev_member_shadowed",
    entry_point = "//tests/dev_server/member",
    node_modules = "//tests/dev_server/member/other:node_modules",
    tags = ["manual"],  # Rejected subject is reached by the analysis test.
)

direct_npm_identity_test(
    name = "app_importer_store_cannot_shadow_member_npm_binding_test",
    messages = [
        "source 'tests/dev_server/member/value.ts'",
        "member-only@1.0.0/node_modules/member-only",
        "but app importer @@//tests/dev_server/member/other:node_modules links @@//tests/dev_server/member/other:node_modules/.pnpm/member-only@2.0.0",
        "the app's link is what a bare specifier reaches",
    ],
    target_under_test = ":dev_member_shadowed",
)

configuration_source(name = "configuration_source")

transitioned_source(
    name = "transitioned_source",
    producer = ":configuration_source",
    server = ":configuration_source",
)

filegroup(
    name = "configuration_fixture",
    srcs = [":transitioned_source"],
    output_group = "fixture",
)

# keep
ts_compile(
    name = "configuration_entry",
    srcs = [":transitioned_source"],
    emit = False,
)

# keep
ts_dev_server(
    name = "dev_configuration",
    entry_point = ":configuration_entry",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    server = "//vite:dev_server",
)

# One node_modules for every dev server here.
# keep
node_modules(
    name = "node_modules",
    hoist = "//tests/npm:node_modules/.pnpm/node_modules",
    deps = [
        "@npm//:vite",
        "@npm//:vitejs_plugin-react",
        "@npm//:zod",
    ],
)

# The basic dev server target — the primary output of SP2.
# `bazel build //tests/dev_server:dev` verifies the rule builds.
# `bazel run //tests/dev_server:dev` would start the Vite dev server.
ts_dev_server(
    name = "dev",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5173,
    server = "//vite:dev_server",
)

# Dev server with the vite-plugin-bazel for enhanced .ts resolution and HMR.
# This demonstrates SP2.2: building the plugin inside Bazel and wiring it in.
ts_dev_server(
    name = "dev_with_plugin",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5174,
    server = "//vite:dev_server",
)

# Dev server with React Fast Refresh — preserves component state across HMR.
ts_dev_server(
    name = "dev_with_react_refresh",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5175,
    react_refresh = True,
    server = "//vite:dev_server",
)

# Dev server with both React Fast Refresh and vite-plugin-bazel.
ts_dev_server(
    name = "dev_with_react_refresh_and_plugin",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5176,
    react_refresh = True,
    server = "//vite:dev_server",
)

# A vite_config naming a package in optimizeDeps.include -- the one resolution
# path no plugin can reach, and so the direct test of the workspace npm link.
ts_dev_server(
    name = "dev_with_optimize_deps",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5181,
    server = "//vite:dev_server",
    vite_config = "optimize_deps_config.mjs",
)

# A user-supplied vite_config, the shape a framework plugin needs: a bare npm
# import for the plugin package, and a plugins array. The rule loads a copy of it
# in bin, so that bare import resolves through the Bazel npm tree.
ts_dev_server(
    name = "dev_with_user_config",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5177,
    server = "//vite:dev_server",
    vite_config = "user_config.mjs",
)

# The composed form: the same config whose relative import used to fail, with the
# sibling it imports declared. Both are staged, so `./user_config_helper.mjs`
# resolves in the staged tree exactly as it does in the source tree.
ts_dev_server(
    name = "dev_with_composed_user_config",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5180,
    server = "//vite:dev_server",
    vite_config = "user_config_relative.mjs",
    vite_config_srcs = ["user_config_helper.mjs"],
)

ts_dev_server(
    name = "dev_with_relative_user_config",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5178,
    server = "//vite:dev_server",
    vite_config = "user_config_relative.mjs",
)

# keep
ts_compile(
    name = "source_app",
    srcs = ["dev_app.ts"],
    emit = False,
    deps = ["//tests/dev_server/lib:source_lib"],
)

# keep
ts_dev_server(
    name = "dev_oj_source",
    entry_point = ":source_app",
    node_modules = ":node_modules",
    port = 5184,
)

ts_dev_server(
    name = "dev_oj",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5179,
)

ts_dev_server(
    name = "dev_oj_with_plugin",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5182,
    vite_config = "oj_config.mjs",
)

# Each variant is started for real and interrogated over HTTP; the env says which
# target to run, the port the rule was given (the evaluated config has to report
# it), and which of the two plugins the response must show evidence of.
# The server itself is started on a kernel-assigned port: on the configured one,
# two concurrent `bazel test` runs make Vite increment past the collision and one
# run then answers the other's requests.
[
    go_test(
        name = "{}_behaviour_test".format(target),
        size = "medium",
        srcs = [
            "dev_server_behaviour_test.go",
            "devserver_harness_test.go",
            "launcher_config_test.go",
            "symlinked_tmp_test.go",
        ],
        data = [
            "read_config.mjs",
            ":{}".format(target),
            "//ts/toolchain:node_resolved",
        ] + ([
            ":configuration_fixture",
            ":dev_configuration",
            ":dev_member_npm",
            ":dev_source_contexts",
            "//tests/npm/dev_inherited_types:composed_apps",
            "//tests/npm/dev_inherited_types:previous_member_dev",
        ] if target == "dev_with_plugin" else []),
        env = {
            "DEV_BAZEL_PLUGIN": bazel_plugin,
            "DEV_IMPL": impl,
            "DEV_PORT": port,
            "DEV_REACT_REFRESH": react_refresh,
            "DEV_TARGET": target,
            "DEV_USER_CONFIG": user_config,
        },
        tags = ["requires-network"],
        deps = [
            "//tests/hmrsocket",
            "//tests/verify",
        ],
    )
    for target, port, bazel_plugin, react_refresh, user_config, impl in [
        ("dev", "5173", "0", "0", "0", "vite"),
        ("dev_oj", "5179", "0", "0", "0", "oj"),
        ("dev_oj_source", "5184", "0", "0", "0", "oj"),
        ("dev_oj_with_plugin", "5182", "1", "0", "0", "oj"),
        ("dev_with_plugin", "5174", "1", "0", "0", "vite"),
        ("dev_with_react_refresh", "5175", "0", "1", "0", "vite"),
        ("dev_with_react_refresh_and_plugin", "5176", "1", "1", "0", "vite"),
        ("dev_with_user_config", "5177", "0", "0", "1", "vite"),
        # Same assertions, but the plugin comes from a module the config imports
        # relatively -- which only resolves because vite_config_srcs staged it.
        ("dev_with_composed_user_config", "5180", "0", "0", "1", "vite"),
    ]
]

go_test(
    name = "optimize_deps_test",
    size = "medium",
    srcs = [
        "devserver_harness_test.go",
        "launcher_config_test.go",
        "optimize_deps_test.go",
    ],
    data = [
        ":dev_with_optimize_deps",
        "//ts/toolchain:node_resolved",
    ],
    tags = ["requires-network"],
    deps = [
        "//tests/hmrsocket",
        "//tests/verify",
    ],
)

# What a vite_config can and cannot import, and where the rule loads it from.
# No server comes up here: a config that fails to load fails before Vite listens.
go_test(
    name = "vite_config_boundary_test",
    size = "small",
    srcs = [
        "launcher_config_test.go",
        "vite_config_boundary_test.go",
    ],
    data = [
        "user_config_helper.mjs",
        ":dev_with_react_refresh",
        ":dev_with_relative_user_config",
        ":dev_with_user_config",
        "//ts/toolchain:node_resolved",
    ],
    deps = [
        "//tests/hmrsocket",
        "//tests/verify",
    ],
)

# Vite upgrades HMR sockets on the base path with the vite-hmr subprotocol.
[
    go_test(
        name = "{}_hmr_latency_test".format(target),
        size = "medium",
        srcs = [
            "devserver_harness_test.go",
            "hmr_latency_test.go",
            "hmr_socket_test.go",
            "launcher_config_test.go",
        ],
        data = [":{}".format(target)],
        env = {
            "DEV_IMPL": impl,
            "DEV_TARGET": target,
            "HMR_WS_PATH": ws_path,
            "HMR_WS_PROTOCOL": ws_protocol,
        },
        tags = ["requires-network"],
        deps = [
            "//tests/hmrsocket",
            "//tests/verify",
        ],
    )
    for target, impl, ws_path, ws_protocol in [
        ("dev", "vite", "/", "vite-hmr"),
        ("dev_oj", "oj", "/__ws", ""),
        ("dev_oj_with_plugin", "oj", "/__ws", ""),
        ("dev_with_plugin", "vite", "/", "vite-hmr"),
    ]
]
