package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# @npm is translated from this, and //:add_package_npm edits it; nothing in this
# package builds it.
exports_files(["pnpm-lock.yaml"])

exports_files(
    ["node_modules_tests.bzl"],
    visibility = ["//tests/npm:__subpackages__"],
)

npm_virtual_store(name = "node_modules/.pnpm")

# The root importer: a link per name it declares, beside the store. The chain
# every fixture outside an importer's package resolves through.
# keep
node_modules(
    name = "node_modules",
    hoist = ":node_modules/.pnpm/node_modules",
    visibility = ["//visibility:public"],
    deps = [
        "@npm//:bun-types",
        "@npm//:culori",
        "@npm//:happy-dom",
        "@npm//:oxlint",
        "@npm//:test-exclude",
        "@npm//:tsup",
        "@npm//:types_bun",
        "@npm//:types_culori",
        "@npm//:types_node",
        "@npm//:typescript",
        "@npm//:vite",
        "@npm//:vitejs_plugin-react",
        "@npm//:vitest",
        "@npm//:vitest_coverage-v8",
        "@npm//:zod",
    ],
)

node_modules_test(
    name = "node_modules_test",
    dir = "tests/npm/node_modules",
    hoisted = [
        "minimatch=minimatch@10.2.4",
        "undici-types=undici-types@6.21.0",
    ],
    hoisted_members = [
        "hoisted-member",
        "nested-shared",
    ],
    links = [
        "@types/bun",
        "@types/culori",
        "@types/node",
        "@vitejs/plugin-react",
        "@vitest/coverage-v8",
        "bun-types",
        "culori",
        "happy-dom",
        "oxlint",
        "test-exclude",
        "tsup",
