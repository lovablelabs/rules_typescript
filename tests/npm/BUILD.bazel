# Both peer resolutions of one version through one importer: app-a's
# ansi-styles declared, the other only through wrap-ansi's edge.

# ── The graph does not depend on the machine that read the lockfile ──────────
#
# fsevents@2.3.3 is `os: [darwin]`. Filtering the lockfile against the host's
# os/cpu -- which is what the module extension used to do -- makes @npm//:fsevents
# exist on a Mac and not exist on Linux, and the extension's result is recorded in
# MODULE.bazel.lock, a file that is committed and shared. So the label has to
# resolve here, on Linux, and the choice of which platform's package a build
# actually pulls has to be a select() resolved at analysis time instead.
go_test(
    name = "npm_platform_independent_graph_test",
    size = "small",
    srcs = ["npm_platform_independent_graph_test.go"],
    data = ["@npm//:fsevents"],
    deps = ["//tests/verify"],
)

# A workspace member's directory can be named after an npm package -- a member at
# `ms/` alongside a dependency on `ms`. The hub then needs the target `:ms` and
# the package `ms/` at once, which is the one way per-importer packages could
# have collided with the flat namespace.
build_test(
    name = "npm_importer_package_name_collision_test",
    targets = [
        "@npm_features//:ms",
        "@npm_features//ms:zod",
    ],
)

