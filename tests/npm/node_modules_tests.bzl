"""An importer's node_modules at analysis: one declared symlink per declared
name into its store tree, every store tree the links reach among the files,
the importer above and the lockfile's hidden hoist; a member's link target,
the view's providers beside its link; the hoist's links, a hoisted member's
by name alone."""

load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
load("//npm/private:store.bzl", "MEMBER_VERSION", "store_key")
load(
    "//ts/private:providers.bzl",
    "NodeModulesInfo",
    "NpmHoistInfo",
    "NpmLinkInfo",
    "NpmPackageInfo",
    "TsInfo",
)

def _node_modules_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    info = target[NodeModulesInfo]
    asserts.true(
        env,
        info.dir.endswith("/" + ctx.attr.dir),
        "the importer's directory: " + info.dir,
    )
    asserts.equals(
        env,
        sorted(ctx.attr.links),
        sorted(info.links.keys()),
        "one link per declared name",
    )
    files = target[DefaultInfo].files.to_list()
    keys = {}
    for name, entry in info.links.items():
        asserts.true(
            env,
            entry.link.is_symlink,
            name + " is a declared symlink",
        )
        asserts.equals(
            env,
            info.dir + "/" + name,
            entry.link.path,
            name + " sits in the directory",
        )
        asserts.true(env, entry.link in files, name + " is among the files")
        for f in entry.store.transitive.to_list():
            if f.is_directory:
                keys[f.dirname.split("/")[-2]] = f
    for key in ctx.attr.stores:
        asserts.true(env, key in keys, key + " is a closure store")
    for key, tree in keys.items():
        asserts.true(env, tree in files, key + "'s tree is in the files")
    asserts.equals(env, target.label, info.label, "the importer's label")
    asserts.equals(
        env,
        ctx.attr.has_parent,
        info.parent != None,
        "the importer above",
    )
    for entry in ctx.attr.hoisted:
        name, key = entry.split("=")
        asserts.true(env, name in info.hoist.links, name + " is a hoisted name")
        if name in info.hoist.links:
            asserts.equals(
                env,
                key,
                info.hoist.links[name].store.key,
                name + "'s hoist link enters pnpm's pick",
            )
    for name in ctx.attr.hoisted_members:
        asserts.true(env, name in info.hoist.members, name + " is hoisted")
        if name in info.hoist.members:
            link = info.hoist.members[name]
            asserts.true(env, link.is_symlink, name + "'s link is declared")
            asserts.true(
                env,
                link.short_path.endswith(
                    "/node_modules/.pnpm/node_modules/" + name,
                ),
                name + "'s link sits in the hidden hoist: " + link.short_path,
            )
    asserts.equals(
        env,
        len(info.links),
        len(analysistest.target_actions(env)),
        "one symlink action per link and no other",
    )
    return analysistest.end(env)

node_modules_test = analysistest.make(
    _node_modules_impl,
    attrs = {
        "dir": attr.string(mandatory = True),
        "links": attr.string_list(),
        "stores": attr.string_list(),
        "has_parent": attr.bool(),
        "hoisted": attr.string_list(
            doc = "`<name>=<store key>` per hoist link the chain carries.",
        ),
        "hoisted_members": attr.string_list(
            doc = "The hoisted workspace members the chain carries, by name.",
        ),
    },
)

def _hoist_links_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    info = target[NpmHoistInfo]
    files = target[DefaultInfo].files.to_list()
    asserts.equals(
        env,
        sorted(ctx.attr.members),
        sorted(info.members.keys()),
        "the hoisted members, by name",
    )
    trees = [f.path for f in files if f.is_directory]
    for name, link in info.members.items():
        asserts.true(env, link.is_symlink, name + "'s link is declared")
        asserts.true(env, link in files, name + "'s link is among the files")
        key = "/" + store_key(name, MEMBER_VERSION, "") + "/"
        asserts.equals(
            env,
            [],
            [p for p in trees if key in p],
            name + "'s tree is behind no link: no dependency on the member",
        )
    asserts.equals(
        env,
        len(info.links) + len(info.members),
        len(analysistest.target_actions(env)),
        "one symlink action per link and no other",
    )
    return analysistest.end(env)

hoist_links_test = analysistest.make(
    _hoist_links_impl,
    attrs = {
        "members": attr.string_list(
            doc = "The workspace members the hoist links, by name.",
        ),
    },
)

def _member_link_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    link = target[NpmLinkInfo]
    npm = target[NpmPackageInfo]
    asserts.equals(env, ctx.attr.member, npm.package_name, "the member's name")
    asserts.true(env, link.link.is_symlink, "the link is a declared symlink")
    asserts.true(
        env,
        link.link.short_path.endswith("/node_modules/" + ctx.attr.member),
        "the link sits at node_modules/<member>: " + link.link.short_path,
    )
    asserts.equals(env, npm.store, link.store, "the store is the view's")
    asserts.equals(env, ctx.attr.key, link.store.key, "the member's store key")
    asserts.true(env, TsInfo in target, "the view's TsInfo is forwarded")
    files = target[DefaultInfo].files.to_list()
    asserts.true(env, link.link in files, "the link is among the files")
    asserts.true(env, link.store.tree in files, "the tree is among the files")
    return analysistest.end(env)

member_link_test = analysistest.make(
    _member_link_impl,
    attrs = {
        "member": attr.string(mandatory = True),
        "key": attr.string(mandatory = True),
    },
)

def _fails_with(message):
    def _impl(ctx):
        env = analysistest.begin(ctx)
        asserts.expect_failure(env, message)
        return analysistest.end(env)

    return analysistest.make(_impl, expect_failure = True)

linked_twice_test = _fails_with("linked twice")
hoist_linked_twice_test = _fails_with(
    "'minimatch' linked twice, to @@//tests/npm:node_modules/.pnpm/" +
    "minimatch@9.0.9/node_modules/minimatch and @@//tests/npm:" +
    "node_modules/.pnpm/minimatch@10.2.4/node_modules/minimatch",
)
member_in_deps_test = _fails_with("node_modules_member(")
bin_entry_missing_test = _fails_with("entry script 'cli.js' not found")
