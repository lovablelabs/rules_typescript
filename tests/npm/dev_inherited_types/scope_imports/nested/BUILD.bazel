direct_npm_identity_test(
    name = "package_import_rejects_nearer_module_store_test",
    messages = [
        "source 'tests/npm/dev_inherited_types/scope_imports/package.json'",
        "npm 'scope-store'",
        "scope-store@1.0.0/node_modules/scope-store",
