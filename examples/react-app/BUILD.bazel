load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_virtual_store")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_binary", "ts_compile", "ts_config", "ts_pnpm")

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
    tags = ["manual"],
)

npm_virtual_store(name = "node_modules/.pnpm")

ts_pnpm(name = "pnpm")

# The root importer: the chain every target here resolves its npm deps through.
node_modules(
    name = "node_modules",
    hoist = ":node_modules/.pnpm/node_modules",
    visibility = ["//visibility:public"],
    deps = [
        "@npm//:happy-dom",
        "@npm//:react",
        "@npm//:react-dom",
        "@npm//:testing-library_dom",
        "@npm//:testing-library_react",
        "@npm//:types_react",
        "@npm//:types_react-dom",
        "@npm//:vite",
        "@npm//:vitest",
        "@npm//:zod",
    ],
)

# Bundle the application entry point into a single ESM file.
ts_binary(
    name = "app_bundle",
    entry_point = "//src/app",
    format = "esm",
    sourcemap = True,
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

ts_compile(
    name = "root",
    emit = True,
    package_scopes = ["package.json"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    srcs = ["package.json"],
    visibility = ["//:__subpackages__"],
)
