{
  "name": "@rules_typescript/eslint-plugin-isolated-declarations",
  "version": "0.2.0",
  "description": "ESLint plugin for isolated declarations \u2014 enforces explicit return types on exports to enable fast per-file .d.ts emit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/rules_typescript.git",
    "directory": "eslint-plugin"
  },
  "homepage": "https://github.com/mikn/rules_typescript/tree/main/eslint-plugin#readme",
  "bugs": "https://github.com/mikn/rules_typescript/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "prepack": "tsup"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "typescript",
    "isolated-declarations",
    "bazel",
    "rules_typescript"
  ],
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8.0.0",
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.68.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
