load("@gazelle//:def.bzl", "gazelle_binary")
load("@io_bazel_rules_go//go:def.bzl", "go_test")

gazelle_binary(
    name = "gazelle_typescript",
    testonly = True,
    languages = ["@rules_typescript//gazelle:typescript"],
)

gazelle_binary(
    name = "gazelle_proto_test",
    testonly = True,
    languages = [
        "@gazelle//language/proto",
        "@rules_typescript//gazelle:typescript",
    ],
)

# //gazelle:typescript_test's sources over this module's Gazelle. The skipped
# tests read data files from packages this workspace cannot load.
go_test(
    name = "gazelle_test",
    size = "large",
    srcs = ["@rules_typescript//gazelle:test_srcs"],
    args = ["-test.skip=^(TestDocs_|TestEdgeLabel_CuloriPairing$$|TestEdgeLabel_AugmentationNamesThePackage$$|TestOwner_SampleListingIsATestOnlyPackage$$|TestProgram_VitestConfigsDiscoveredAfterFirstListing$$)"],
    data = [
        ":gazelle_proto_test",
        ":gazelle_typescript",
    ],
    embed = ["@rules_typescript//gazelle:typescript"],
    env = {
        "PROTO_GAZELLE": "$(rlocationpath :gazelle_proto_test)",
        "TS_GAZELLE": "$(rlocationpath :gazelle_typescript)",
    },
    shard_count = 8,
    deps = [
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//language",
        "@gazelle//language/proto",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//walk",
        "@io_bazel_rules_go//go/runfiles",
        "@rules_typescript//gazelle/incremental",
        "@rules_typescript//ts/tools/explainfiles",
        "@rules_typescript//ts/tools/tsconfig",
    ],
)
