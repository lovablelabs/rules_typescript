"""The Gazelle extension's tests under bazel-gazelle 2.0.0-beta.2.

Its v2 update loop drives the extension through the compat adapter.
"""

module(
    name = "e2e_gazelle_latest",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "rules_typescript",
    path = "../..",
)

bazel_dep(name = "gazelle", version = "2.0.0-beta.2")
bazel_dep(name = "rules_go", version = "0.65.0", repo_name = "io_bazel_rules_go")

register_toolchains("@rules_typescript//ts/toolchain:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
use_repo(go_deps, "com_github_bazelbuild_buildtools")
