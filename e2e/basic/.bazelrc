# A direct dep the graph resolves to another version, such as Gazelle past its
# floor or rules_go, fails instead of warning.
common --check_direct_dependencies=error

# Correctness: hermetic action environment so PATH is not leaked into actions.
build --incompatible_strict_action_env

# Type-check on every build (tsgo validation action).
# This makes type errors fail `bazel build` — the same behaviour as `go build`.
build --output_groups=+_validation

# Test output
test --test_output=errors
test --test_summary=terse
