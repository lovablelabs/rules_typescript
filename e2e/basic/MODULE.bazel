"""End-to-end test workspace for rules_typescript.

Exercises ts_compile, ts_test, and ts_binary against a minimal
multi-package TypeScript project, and the Gazelle extension on the
bazel-gazelle floor.
"""

module(
    name = "e2e_basic",
    version = "0.0.0",
)

bazel_dep(name = "rules_typescript", version = "0.0.0")

register_toolchains("@rules_typescript//ts/toolchain:all")

local_path_override(
    module_name = "rules_typescript",
    path = "../..",
)

# ─── Gazelle floor ───────────────────────────────────────────────────────────
# The consumer floor; .bazelrc fails the build if the graph resolves another.
# rules_go and go_deps serve the floor suite in BUILD.bazel, not consumers.
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_go", version = "0.62.0", repo_name = "io_bazel_rules_go")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
use_repo(go_deps, "com_github_bazelbuild_buildtools")

# ─── npm dependencies from pnpm-lock.yaml ────────────────────────────────────
# Run `pnpm install` in this directory to update pnpm-lock.yaml.

npm = use_extension("@rules_typescript//npm:extensions.bzl", "npm")
npm.translate_lock(pnpm_lock = "//:pnpm-lock.yaml")
use_repo(npm, "npm", "pnpm")

# Temporary until upstream ships the sandbox resource-directory fix:
# https://github.com/hermeticbuild/hermetic-llvm/blob/v0.8.21/toolchain/merged_resource_directory.bzl
archive_override(
    module_name = "llvm",
    integrity = "sha256-fasiVGwpsGh4ahOXO2ms19Y1Q7GYkLFDcukTLXErSD0=",
    patch_strip = 1,
    patches = ["//:llvm-resource-directory.patch"],
    remote_patch_strip = 1,
    remote_patches = {"https://bcr.bazel.build/modules/llvm/0.8.21/patches/module_dot_bazel_version.patch": "sha256-w2NrJjoyIPeejybJd6EHngAPnTVhwS3Cgk/U3ru64wo="},
    strip_prefix = "hermetic-llvm-0.8.21",
    urls = ["https://github.com/hermeticbuild/hermetic-llvm/releases/download/v0.8.21/hermetic-llvm-v0.8.21.tar.gz"],
)
