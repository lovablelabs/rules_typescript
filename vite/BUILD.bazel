# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# A ts_compile baseline, not data: it is named by the tsconfig attr.
# gazelle:exclude vite.tsconfig.json

# gazelle:exclude src

# BUILD.bazel for the vite/ package.
#
# vite-plugin-bazel (the npm plugin in vite/src/) is compiled inside Bazel
# using esbuild to produce a single bundled ESM JavaScript file.  This
# artifact can be imported by any generated vite.config.mjs to wire the
# Bazel-aware Vite plugin into the dev server.
#
# The compiled plugin is placed at:
#   bazel-bin/vite/vite_plugin_bazel.mjs
#
# For production distribution, the pre-built dist/ (built with tsup) is used
# for npm publishing.  The Bazel build target is for in-workspace use only.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_compile")
load(":dev_server.bzl", "vite_dev_server")
load(":plugin.bzl", "esbuild_bundle")

package(default_visibility = ["//visibility:public"])

# //vite/tests:peer_version_test reads peerDependencies.vite out of the manifest.
exports_files(["package.json"])

bzl_library(
    name = "dev_server_bzl",
    srcs = ["dev_server.bzl"],
    deps = ["//ts/private:providers"],
)

vite_dev_server(name = "dev_server")

bzl_library(
    name = "plugin",
    srcs = ["plugin.bzl"],
    deps = [
        "//ts/private:providers",
        "//ts/private:runtime",
    ],
)

# The plugin build action's node_modules: vite/esbuild's lockfile, not @npm,
# which resolves into the consumer's and need not have esbuild at all.
# keep
node_modules(
    name = "node_modules",
    hoist = "//vite/esbuild:node_modules/.pnpm/node_modules",
    deps = [
        "@npm_esbuild//:esbuild",
        "@npm_esbuild//:resolve.exports",
    ],
)

# Build the vite-plugin-bazel TypeScript source into a single bundled ESM file.
esbuild_bundle(
    name = "vite_plugin_bazel",
    srcs = [
        "src/index.ts",
        "src/plugin.ts",
        "src/resolver.ts",
        "src/watcher.ts",
    ],
    out = "vite_plugin_bazel.mjs",
    entry_point = "src/index.ts",
    external = ["vite"],
    node_modules = ":node_modules",
)

# esbuild strips types without checking them, so this is the type check for the
# sources :vite_plugin_bazel bundles.
ts_compile(
    name = "plugin_typecheck",
    srcs = glob(["src/*.ts"]),
    node_modules = "//tests/npm:node_modules",
    # keep
    source_node_modules = [":node_modules"],
    tsconfig = "vite.tsconfig.json",
    deps = [
        "@npm//:types_node",
        "@npm//:vite",
        "@npm_esbuild//:resolve.exports",  # keep
    ],
)

# tsup strips types without checking them, the same split as :vite_plugin_bazel
# above: this is the type check for the tsup config itself.
ts_compile(
    name = "tsup_config",
    srcs = ["tsup.config.ts"],
    node_modules = "//tests/npm:node_modules",
    deps = ["@npm//:tsup"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
