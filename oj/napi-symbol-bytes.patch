+  let symbols_path = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap())
+    .join("napi_symbols.def");
+  std::fs::write(&symbols_path, symbol_exports(std::env::consts::OS)).unwrap();
+  let symbols_path = symbols_path.display();
 
   #[cfg(target_os = "windows")]
   println!("cargo:rustc-link-arg-bin={name}=/DEF:{}", symbols_path);
