--- a/crates/oj_deno_napi/lib.rs
+++ b/crates/oj_deno_napi/lib.rs
@@ -1245,10 +1245,23 @@ fn op_napi_open<'scope>(
   Ok(exports)
 }
 
+pub fn symbol_exports(target_os: &str) -> &'static [u8] {
+  match target_os {
+    "windows" => include_bytes!("generated_symbol_exports_list_windows.def"),
+    "macos" => include_bytes!("generated_symbol_exports_list_macos.def"),
+    "linux" | "freebsd" | "openbsd" | "android" => {
+      include_bytes!("generated_symbol_exports_list_linux.def")
+    }
+    _ => panic!("unsupported symbol export target: {target_os}"),
+  }
+}
+
 #[allow(clippy::print_stdout, reason = "cargo build script output")]
 pub fn print_linker_flags(name: &str) {
-  let symbols_path =
