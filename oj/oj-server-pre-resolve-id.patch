+        meta.is_some_and(|meta| meta.file == file)
+    })
+}
+
+fn is_resolver_answer(state: &ServerState, spec: &str, id: &str) -> bool {
+    let answers = state.resolver_answers.lock().unwrap();
+    answers.contains(&(spec.to_string(), id.to_string()))
