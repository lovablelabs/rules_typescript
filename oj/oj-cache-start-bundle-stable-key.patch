+    /// The closure without oj's own cache files. The client bundle drops its
+    /// build dir by path prefix, which misses when that dir is reached through
+    /// a symlink and the bundler reports realpaths; `manifest.ts` then joins
+    /// the key, and every boot rewrites it before restoring.
+    fn key_closure(&self, files: Vec<PathBuf>) -> Vec<PathBuf> {
+        let Some(cache) = self.dir.parent() else {
+            return files;
+        };
+        let real = fs::canonicalize(cache).ok();
+        files
+            .into_iter()
+            .filter(|p| !p.starts_with(cache) && !real.as_deref().is_some_and(|r| p.starts_with(r)))
+            .collect()
+    }
